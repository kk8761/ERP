  @@index([slug])
}

model TenantUser {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String
  
  // Tenant-specific role (in addition to global role)
  tenantRole      String?  @db.VarChar(100)
  
  // Access control
  isActive        Boolean  @default(true)
  invitedAt       DateTime @default(now())
  joinedAt        DateTime?
  lastAccessAt    DateTime?
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User     @relation("UserTenantMemberships", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, userId])
  @@index([tenantId, isActive])
  @@index([userId])
}

model TenantCustomField {
  id              String   @id @default(uuid())
  tenantId        String
  
  // Field definition
  entityType      String   @db.VarChar(100) // product, customer, order, etc.
  fieldName       String   @db.VarChar(100)
  fieldLabel      String   @db.VarChar(255)
  fieldType       String   @db.VarChar(50) // text, number, date, boolean, select, multiselect
  
  // Options for select/multiselect
  options         String[] // Array of options
  
  // Validation
  isRequired      Boolean  @default(false)
  defaultValue    String?  @db.Text
  validationRules Json?    // {min, max, pattern, etc.}
  
  // Display
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  helpText        String?  @db.Text
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, entityType, fieldName])
  @@index([tenantId, entityType, isActive])
}

model TenantWorkflow {
  id              String   @id @default(uuid())
  tenantId        String
  
  // Workflow definition
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  entityType      String   @db.VarChar(100) // Entity this workflow applies to
  
  // Trigger
  triggerType     String   @db.VarChar(50) // on_create, on_update, on_delete, scheduled, manual
  triggerConditions Json?  // Conditions that must be met
  
  // Actions
  actions         Json     // Array of actions to execute
  
  // Status
  isActive        Boolean  @default(true)
  executionCount  Int      @default(0)
  lastExecutedAt  DateTime?
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions      TenantWorkflowExecution[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, isActive])
  @@index([entityType])
}

model TenantWorkflowExecution {
  id              String   @id @default(uuid())
  workflowId      String
  tenantId        String
  
  // Execution details
  triggerData     Json     // Data that triggered the workflow
  status          String   @default("pending") @db.VarChar(50) // pending, running, completed, failed
  
  // Results
  actionsExecuted Int      @default(0)
  actionsFailed   Int      @default(0)
  executionLog    Json?    // Detailed log of execution
  errorMessage    String?  @db.Text
  
  // Timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  duration        Int?     // Milliseconds
  
  workflow        TenantWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([workflowId, status])
  @@index([tenantId, startedAt])
}

// Tenant provisioning log
model TenantProvisioningLog {
  id              String   @id @default(uuid())
  tenantId        String
  
  // Provisioning step
  step            String   @db.VarChar(100) // create_schema, seed_data, configure_features, etc.
  status          String   @db.VarChar(50) // pending, in_progress, completed, failed
  
  // Details
  message         String?  @db.Text
  errorDetails    Json?
  
  // Timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?
