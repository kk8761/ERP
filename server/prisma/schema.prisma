  product             DimProduct   @relation(fields: [productKey], references: [productKey])
  warehouse           DimWarehouse @relation(fields: [warehouseKey], references: [warehouseKey])
  employee            DimEmployee  @relation(fields: [employeeKey], references: [employeeKey])
  
  @@index([dateKey])
  @@index([productKey])
  @@index([warehouseKey])
  @@index([employeeKey])
