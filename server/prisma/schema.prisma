  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([courseId, employeeId])
  @@index([employeeId])
  @@index([status])
}

// Succession Plan model
model SuccessionPlan {
  id              String   @id @default(uuid())
  positionTitle   String   @db.VarChar(255)
  department      String   @db.VarChar(100)
  
  // Current incumbent
  currentEmployeeId String?
  
  // Criticality
  criticality     String   @default("medium") @db.VarChar(50) // low, medium, high, critical
  
  // Risk assessment
  riskLevel       String   @default("medium") @db.VarChar(50) // low, medium, high
  
  // Succession candidates
  candidates      Json     // Array of candidate objects with employeeId, readiness, developmentNeeds
  
  // Timeline
  targetDate      DateTime?
  
  status          String   @default("active") @db.VarChar(50) // active, in_progress, completed, on_hold
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([department])
  @@index([criticality])
}

// Payroll model
model Payroll {
  id              String   @id @default(uuid())
  payrollNo       String   @unique @db.VarChar(100)
  
  // Payroll period
  periodStart     DateTime
  periodEnd       DateTime
  paymentDate     DateTime
  
  // Country/region for localization
  country         String   @db.VarChar(50)
  currency        String   @default("USD") @db.VarChar(10)
  
  // Status
  status          String   @default("draft") @db.VarChar(50) // draft, calculated, approved, processed, paid
  
  // Totals
  totalGrossPay   Float    @default(0)
  totalDeductions Float    @default(0)
  totalNetPay     Float    @default(0)
  
  // Relations
  payrollItems    PayrollItem[]
  
  // Processing details
  processedBy     String?
  processedDate   DateTime?
  approvedBy      String?
  approvedDate    DateTime?
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([periodEnd])
  @@index([status])
}

// Payroll Item model (per employee)
model PayrollItem {
  id              String   @id @default(uuid())
  payrollId       String
  payroll         Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Earnings
  basicSalary     Float
  overtime        Float    @default(0)
  bonus           Float    @default(0)
  allowances      Json     // Array of allowance objects {type, amount}
  
  // Deductions
  tax             Float    @default(0)
  socialSecurity  Float    @default(0)
  insurance       Float    @default(0)
  otherDeductions Json     // Array of deduction objects {type, amount}
  
  // Calculated amounts
  grossPay        Float
  totalDeductions Float
  netPay          Float
  
  // Tax forms and documents
  taxFormUrl      String?  @db.Text
  payslipUrl      String?  @db.Text
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

// Employee Certification model
model EmployeeCertification {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  certificationName String @db.VarChar(255)
  issuingOrg      String   @db.VarChar(255)
  issueDate       DateTime
  expiryDate      DateTime?
  
  certificateUrl  String?  @db.Text
  
  status          String   @default("active") @db.VarChar(50) // active, expired, revoked
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([employeeId])
  @@index([expiryDate])
}

// Employee Document model
model EmployeeDocument {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  documentType    String   @db.VarChar(100) // contract, id_proof, tax_form, performance_review, etc.
  documentName    String   @db.VarChar(255)
  documentUrl     String   @db.Text
  
  uploadedBy      String?
  uploadedDate    DateTime @default(now())
  
  expiryDate      DateTime?
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([employeeId])
  @@index([documentType])
}

// ─── Enterprise Asset Management (EAM) Module ──────────────

// Asset Registry model
model Asset {
  id              String   @id @default(uuid())
  assetNumber     String   @unique @db.VarChar(100)
  name            String   @db.VarChar(255)
  category        String   @db.VarChar(50) // machinery, vehicle, building, equipment, it_asset
  location        String   @db.VarChar(255)
  department      String?  @db.VarChar(100)
  status          String   @default("operational") @db.VarChar(50) // operational, maintenance, breakdown, retired, disposed
  
  // Acquisition details
  acquisitionDate DateTime
  acquisitionCost Float
  currentValue    Float
  
  // Depreciation
  depreciationMethod String? @db.VarChar(50) // straight_line, declining_balance, units_of_production
  usefulLife      Int?     // in years
  salvageValue    Float?
  
  // Asset details
  specifications  Json     // Key-value pairs for asset specifications
  qrCode          String?  @db.VarChar(255)
  serialNumber    String?  @db.VarChar(100)
  manufacturer    String?  @db.VarChar(255)
  model           String?  @db.VarChar(255)
  warrantyExpiry  DateTime?
  
  // Hierarchy
  parentAssetId   String?
  parentAsset     Asset?   @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets     Asset[]  @relation("AssetHierarchy")
  
  // Relations
  maintenancePlans MaintenancePlan[]
  maintenanceTasks MaintenanceTask[]
  maintenanceRecords MaintenanceRecord[]
  healthRecords   AssetHealth[]
  utilizationRecords AssetUtilization[]
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([category, status])
  @@index([location])
  @@index([parentAssetId])
  @@index([assetNumber])
}

// Maintenance Plan model
model MaintenancePlan {
  id              String   @id @default(uuid())
  planNumber      String   @unique @db.VarChar(100)
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  
  // Frequency
  frequency       String   @db.VarChar(50) // daily, weekly, monthly, quarterly, yearly, usage_based
  frequencyValue  Int?     // For usage-based (e.g., every 1000 hours)
  
  // Tasks and parts
  tasks           String[] // Array of task descriptions
  estimatedDuration Float  // in hours
  requiredParts   String[] // Array of product IDs
  
  // Status
  isActive        Boolean  @default(true)
  lastExecuted    DateTime?
  nextScheduled   DateTime?
  
  // Relations
  maintenanceTasks MaintenanceTask[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([assetId, isActive])
  @@index([nextScheduled])
}

// Maintenance Task model (Work Orders)
model MaintenanceTask {
  id              String   @id @default(uuid())
  taskNumber      String   @unique @db.VarChar(100)
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  planId          String?
  plan            MaintenancePlan? @relation(fields: [planId], references: [id])
  
  taskType        String   @db.VarChar(50) // preventive, corrective, predictive, breakdown
  description     String   @db.Text
  priority        String   @default("medium") @db.VarChar(50) // low, medium, high, critical
  
  // Scheduling
  scheduledDate   DateTime
  completedDate   DateTime?
  
  // Assignment
  technicianId    String?
  technicianName  String?  @db.VarChar(255)
  
  // Status
  status          String   @default("scheduled") @db.VarChar(50) // scheduled, in_progress, completed, cancelled
  
  // Costs
  actualDuration  Float?   // in hours
  laborCost       Float?
  partsCost       Float?
  totalCost       Float?
  
  // Relations
  maintenanceRecords MaintenanceRecord[]
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([assetId, status])
  @@index([planId])
  @@index([scheduledDate])
  @@index([technicianId, status])
}

// Maintenance Record model (Completion records)
model MaintenanceRecord {
  id              String   @id @default(uuid())
  taskId          String
  task            MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  completedDate   DateTime
  technicianId    String
  technicianName  String   @db.VarChar(255)
  
  actualDuration  Float    // in hours
  
  // Spare parts used
  spareParts      Json     // Array of {productId, productName, quantity, unitCost, totalCost}
  
  // Costs
  laborCost       Float
  partsCost       Float
  totalCost       Float
  
  // Work details
  workPerformed   String   @db.Text
  findings        String?  @db.Text
  recommendations String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([taskId])
  @@index([assetId])
  @@index([completedDate])
}

// Asset Health Monitoring model
model AssetHealth {
  id              String   @id @default(uuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  healthScore     Float    // 0-100
  status          String   @db.VarChar(50) // excellent, good, fair, poor, critical
  
  // Metrics
  metrics         Json     // Array of {metricName, value, unit, timestamp, status}
  
  // Inspection dates
  lastInspectionDate DateTime?
  nextInspectionDate DateTime?
  
  // Reliability metrics
  mtbf            Float?   // Mean Time Between Failures (hours)
  mttr            Float?   // Mean Time To Repair (hours)
  availability    Float?   // Percentage
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([assetId])
  @@index([healthScore])
  @@index([status])
}

// Asset Utilization Tracking model
model AssetUtilization {
  id              String   @id @default(uuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  period          DateTime @db.Date // Month/Year
  
  // Hours tracking
  totalHours      Float    // Total hours in period
  operationalHours Float
  maintenanceHours Float
  downtimeHours   Float
  
  // Calculated metrics
  utilizationRate Float    // Percentage (operationalHours / totalHours * 100)
  efficiency      Float    // Percentage
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([assetId, period])
  @@index([assetId])
  @@index([period])
}

// Plant Shutdown Planning model
model PlantShutdown {
  id              String   @id @default(uuid())
  shutdownNumber  String   @unique @db.VarChar(100)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  
  // Schedule
  startDate       DateTime
  endDate         DateTime
  
  // Status
  status          String   @default("planned") @db.VarChar(50) // planned, in_progress, completed, cancelled
  
  // Assets and tasks
  assets          Json     // Array of {assetId, assetName, maintenanceTasks, estimatedDuration, assignedTechnician, status}
  
  // Costs
  totalEstimatedCost Float
  actualCost      Float?
  
  // Progress
  completionPercentage Float @default(0)
  
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([status])
  @@index([startDate])
}

// ─── Project Systems Module ────────────────────────────────

// Project model
model Project {
  id              String   @id @default(uuid())
  projectNumber   String   @unique @db.VarChar(100)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  
  // Project classification
  projectType     String   @db.VarChar(50) // internal, customer_project, capital_project, research
  status          String   @default("planning") @db.VarChar(50) // planning, active, on_hold, completed, cancelled
  
  // Timeline
  startDate       DateTime
  endDate         DateTime
  
  // Budget and costs
  budget          Float
  actualCost      Float    @default(0)
  
  // Project structure (stored as JSON for flexibility)
  phases          Json     // Array of ProjectPhase objects
  resources       Json     // Array of ResourceAllocation objects
  milestones      Json     // Array of Milestone objects
  
  // Customer information
  customerId      String?
  customerName    String?  @db.VarChar(255)
  
  // Project manager
  projectManagerId   String?
  projectManagerName String? @db.VarChar(255)
  
  notes           String?  @db.Text
  
  // Relations
  costs           ProjectCost[]
  evmReports      ProjectEVM[]
  invoices        ProjectInvoice[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([status])
  @@index([projectType])
  @@index([projectManagerId])
  @@index([customerId])
  @@index([startDate])
}

// Project Cost Tracking model
model ProjectCost {
  id              String   @id @default(uuid())
  projectId       String
  
  // Cost details
  costType        String   @db.VarChar(50) // labor, material, equipment, overhead, other
  description     String   @db.Text
  amount          Float
  date            DateTime
  
  // References
  phaseId         String?  @db.VarChar(100) // Reference to phase in Project.phases JSON
  taskId          String?  @db.VarChar(100) // Reference to task in phase
  resourceId      String?  @db.VarChar(100) // Reference to resource in Project.resources JSON
  invoiceId       String?  // Reference to external invoice
  
  notes           String?  @db.Text
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([projectId, date])
  @@index([costType])
  @@index([date])
}

// Earned Value Management (EVM) model
model ProjectEVM {
  id              String   @id @default(uuid())
  projectId       String
  reportDate      DateTime
  
  // EVM Metrics (stored as JSON for flexibility)
  metrics         Json     // Contains: PV, EV, AC, CV, SV, CPI, SPI, EAC, ETC, VAC, BAC
  
  completionPercentage Float
  notes           String?  @db.Text
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([projectId, reportDate])
  @@index([reportDate])
}

// Project Invoice model
model ProjectInvoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique @db.VarChar(100)
  projectId       String
  
  // Customer information
  customerId      String
  customerName    String   @db.VarChar(255)
  
  // Billing details
  billingType     String   @db.VarChar(50) // time_and_materials, milestone, fixed_price
  startDate       DateTime
  endDate         DateTime
  
  // Amounts
  subtotal        Float
  taxAmount       Float    @default(0)
  total           Float
  
  // Status
  status          String   @default("draft") @db.VarChar(50) // draft, sent, paid, overdue, cancelled
  dueDate         DateTime
  paidDate        DateTime?
  
  // Line items (stored as JSON)
  lineItems       Json     // Array of ProjectInvoiceLineItem objects
  
  notes           String?  @db.Text
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([projectId])
  @@index([status])
  @@index([customerId])
  @@index([dueDate])
}

// Project Template model
model ProjectTemplate {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  
  projectType     String   @db.VarChar(50) // internal, customer_project, capital_project, research
  defaultDuration Int      // in days
  
  // Template structure (stored as JSON)
  phases          Json     // Array of phase templates
  milestones      Json     // Array of milestone templates
  
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  @@index([projectType, isActive])
}

// ─── Governance, Risk & Compliance (GRC) Module ────────────────

// Risk Management model
model RiskItem {
  id                  String   @id @default(uuid())
  riskNumber          String   @unique @db.VarChar(100)
  title               String   @db.VarChar(255)
  description         String   @db.Text
  category            String   @db.VarChar(50) // operational, financial, strategic, compliance, reputational, cybersecurity
  
  // Risk assessment
  likelihood          Int      // 1-5
  impact              Int      // 1-5
  riskScore           Int      // likelihood × impact (1-25)
  
  // Ownership
  owner               String   // User ID
  ownerName           String?  @db.VarChar(255)
  
  // Status
  status              String   @db.VarChar(50) // identified, assessed, mitigating, monitoring, closed
  
  // Mitigations (stored as JSON array)
  mitigations         Json     // Array of {id, action, owner, ownerName, dueDate, status, effectiveness, completedDate, notes}
  
  // Dates
  identifiedDate      DateTime
  lastAssessmentDate  DateTime?
  
  // Additional info
  notes               String?  @db.Text
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?
  
  @@index([category, status])
  @@index([owner])
  @@index([riskScore])
  @@index([status])
}

// Compliance Requirement model
model ComplianceRequirement {
  id                  String   @id @default(uuid())
  requirementNumber   String   @unique @db.VarChar(100)
  regulation          String   @db.VarChar(255) // e.g., "SOX", "GDPR", "HIPAA"
  requirement         String   @db.Text
  applicability       String   @db.Text
  
  // Controls (stored as JSON array)
  controls            Json     // Array of {id, name, description, controlType, frequency, owner, ownerName, evidence, effectiveness, lastTestDate, nextTestDate}
  
  // Status
  status              String   @db.VarChar(50) // compliant, non_compliant, partially_compliant, not_assessed
  
  // Assessment dates
  lastAssessmentDate  DateTime?
  nextAssessmentDate  DateTime?
  
  // Additional info
  notes               String?  @db.Text
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?
  
  @@index([regulation, status])
  @@index([status])
  @@index([nextAssessmentDate])
}

// Audit Plan model
model AuditPlan {
  id                  String   @id @default(uuid())
  auditNumber         String   @unique @db.VarChar(100)
  auditType           String   @db.VarChar(50) // internal, external, regulatory, sox
  scope               String   @db.Text
  
  // Schedule
  startDate           DateTime
  endDate             DateTime
  
  // Auditors (stored as JSON array)
  auditors            Json     // Array of user IDs
  auditorNames        Json?    // Array of names
  
  // Findings (stored as JSON array)
  findings            Json     // Array of {id, severity, description, recommendation, remediation, identifiedDate}
  
  // Status
  status              String   @db.VarChar(50) // planning, in_progress, completed, cancelled
  
  // Additional info
  notes               String?  @db.Text
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?
  
  @@index([auditType, status])
  @@index([status])
  @@index([startDate, endDate])
}

// ─── Data Warehouse & Analytics ────────────────────────────

// Dimension Tables (Star Schema)

model DimDate {
  dateKey         String   @id @db.VarChar(8) // YYYYMMDD
  fullDate        DateTime @db.Date
  year            Int
  quarter         Int
  month           Int
  monthName       String   @db.VarChar(20)
  week            Int
  dayOfMonth      Int
  dayOfWeek       Int
  dayName         String   @db.VarChar(20)
  isWeekend       Boolean  @default(false)
  isHoliday       Boolean  @default(false)
  fiscalYear      Int
  fiscalQuarter   Int
  fiscalPeriod    String   @db.VarChar(20)
  
  // Relations to fact tables
  factSales       FactSales[]
  factInventory   FactInventory[]
  factPurchase    FactPurchase[]
  factProduction  FactProduction[]
  factFinancial   FactFinancial[]
  factHR          FactHR[]
  
  @@index([year, month])
  @@index([fiscalYear, fiscalQuarter])
}

model DimProduct {
  productKey          String   @id @default(uuid())
  productId           String   @db.VarChar(100)
  productName         String   @db.VarChar(255)
  sku                 String   @db.VarChar(100)
  category            String   @db.VarChar(255)
  categoryHierarchy   String   @db.VarChar(500)
  brand               String?  @db.VarChar(100)
  unit                String   @db.VarChar(20)
  trackingType        String   @db.VarChar(20)
  isActive            Boolean  @default(true)
  effectiveDate       DateTime @default(now())
  expiryDate          DateTime?
  
  // Relations to fact tables
  factSales           FactSales[]
  factInventory       FactInventory[]
  factPurchase        FactPurchase[]
  factProduction      FactProduction[]
  
  @@index([productId, effectiveDate])
  @@index([category])
  @@index([isActive])
}

model DimCustomer {
  customerKey     String   @id @default(uuid())
  customerId      String   @db.VarChar(100)
  customerName    String   @db.VarChar(255)
  customerType    String   @db.VarChar(50) // individual, business
  segment         String   @db.VarChar(50) // retail, wholesale, enterprise
  region          String?  @db.VarChar(100)
  country         String?  @db.VarChar(100)
  city            String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  expiryDate      DateTime?
  
  // Relations to fact tables
  factSales       FactSales[]
  
  @@index([customerId, effectiveDate])
  @@index([segment])
  @@index([isActive])
}

model DimSupplier {
  supplierKey     String   @id @default(uuid())
  supplierId      String   @db.VarChar(100)
  supplierName    String   @db.VarChar(255)
  category        String?  @db.VarChar(100)
  rating          Float    @default(0)
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  expiryDate      DateTime?
  
  // Relations to fact tables
  factPurchase    FactPurchase[]
  
  @@index([supplierId, effectiveDate])
  @@index([isActive])
}

model DimWarehouse {
  warehouseKey    String   @id @default(uuid())
  warehouseId     String   @db.VarChar(100)
  warehouseName   String   @db.VarChar(255)
  warehouseCode   String   @db.VarChar(50)
  region          String?  @db.VarChar(100)
  country         String?  @db.VarChar(100)
  city            String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  expiryDate      DateTime?
  
  // Relations to fact tables
  factSales       FactSales[]
  factInventory   FactInventory[]
  factPurchase    FactPurchase[]
  factProduction  FactProduction[]
  
  @@index([warehouseId, effectiveDate])
  @@index([isActive])
}

model DimEmployee {
  employeeKey     String   @id @default(uuid())
  employeeId      String   @db.VarChar(100)
  employeeName    String   @db.VarChar(255)
  department      String?  @db.VarChar(100)
  position        String?  @db.VarChar(100)
  managerId       String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  expiryDate      DateTime?
  
  // Relations to fact tables
  factSales       FactSales[]
  factProduction  FactProduction[]
  factHR          FactHR[]
  
  @@index([employeeId, effectiveDate])
  @@index([department])
  @@index([isActive])
}

// Fact Tables (Star Schema)

model FactSales {
  salesKey        String   @id @default(uuid())
  dateKey         String   @db.VarChar(8)
  productKey      String
  customerKey     String
  warehouseKey    String
  employeeKey     String
  
  orderId         String   @db.VarChar(100)
  orderNumber     String   @db.VarChar(100)
  
  quantity        Float
  unitPrice       Float
  discount        Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float
  costAmount      Float
  profitAmount    Float
  profitMargin    Float
  
  paymentMode     String   @db.VarChar(50)
  orderStatus     String   @db.VarChar(50)
  
  createdAt       DateTime @default(now())
  
  // Relations to dimensions
  date            DimDate      @relation(fields: [dateKey], references: [dateKey])
  product         DimProduct   @relation(fields: [productKey], references: [productKey])
  customer        DimCustomer  @relation(fields: [customerKey], references: [customerKey])
  warehouse       DimWarehouse @relation(fields: [warehouseKey], references: [warehouseKey])
  employee        DimEmployee  @relation(fields: [employeeKey], references: [employeeKey])
  
  @@index([dateKey])
  @@index([productKey])
  @@index([customerKey])
  @@index([warehouseKey])
  @@index([employeeKey])
  @@index([orderId])
}

model FactInventory {
