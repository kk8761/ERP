  createdAt       DateTime @default(now())
  
  @@index([tenantId, step])
  @@index([status])
}

// ─── Low-Code Customization Platform ───────────────────────

// Custom Entity Definition
model CustomEntity {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  pluralName      String   @db.VarChar(255)
  tableName       String   @unique @db.VarChar(100)
  icon            String?  @db.VarChar(50)
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  tenantId        String?
  createdBy       String
  
  // Relations
  fields          CustomField[]
  sourceRelationships CustomRelationship[] @relation("SourceEntity")
  targetRelationships CustomRelationship[] @relation("TargetEntity")
  layouts         CustomLayout[]
  views           CustomView[]
  records         CustomEntityRecord[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([isActive])
}

// Custom Field Definition
model CustomField {
  id              String   @id @default(uuid())
  entityId        String
  name            String   @db.VarChar(100)
  label           String   @db.VarChar(255)
  fieldType       String   @db.VarChar(50) // text, number, boolean, date, datetime, select, multiselect, reference, email, phone, url, textarea, richtext
  dataType        String   @db.VarChar(50) // varchar, integer, decimal, boolean, date, timestamp, text, json
  length          Int?
  precision       Int?
  scale           Int?
  isRequired      Boolean  @default(false)
  isUnique        Boolean  @default(false)
  isIndexed       Boolean  @default(false)
  defaultValue    String?  @db.Text
  options         Json?    // For select/multiselect fields
  validationRules Json?    // min, max, pattern, custom
  referenceEntity String?  // For reference fields
  displayOrder    Int      @default(0)
  helpText        String?  @db.Text
  placeholder     String?  @db.VarChar(255)
  isActive        Boolean  @default(true)
  
  entity          CustomEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([entityId, name])
  @@index([entityId])
  @@index([fieldType])
}

// Custom Entity Relationship
model CustomRelationship {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  sourceEntityId  String
  targetEntityId  String
  relationshipType String  @db.VarChar(50) // one_to_one, one_to_many, many_to_many
  sourceFieldName String   @db.VarChar(100)
  targetFieldName String?  @db.VarChar(100)
  cascadeDelete   Boolean  @default(false)
  isActive        Boolean  @default(true)
  
  sourceEntity    CustomEntity @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity    CustomEntity @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

// Custom Entity Layout (for form generation)
model CustomLayout {
  id              String   @id @default(uuid())
  entityId        String
  name            String   @db.VarChar(255)
  layoutType      String   @db.VarChar(50) // form, list, detail
  isDefault       Boolean  @default(false)
  sections        Json     // Array of sections with fields
  columns         Int      @default(2)
  
  entity          CustomEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([entityId])
}

// Custom Entity View (for list views)
model CustomView {
  id              String   @id @default(uuid())
  entityId        String
  name            String   @db.VarChar(255)
  isDefault       Boolean  @default(false)
  columns         Json     // Array of field names to display
  filters         Json?    // Filter criteria
  sortBy          String?  @db.VarChar(100)
  sortOrder       String?  @default("asc") @db.VarChar(10)
  pageSize        Int      @default(25)
  
  entity          CustomEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([entityId])
}

// Custom Entity Record (stores actual data)
model CustomEntityRecord {
  id              String   @id @default(uuid())
  entityId        String
  data            Json     // Stores all field values
  tenantId        String?
  createdBy       String?
  
  entity          CustomEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([entityId])
  @@index([tenantId])
}

// Custom Field Definition for Standard Entities
// Allows adding custom fields to existing entities like Product, Customer, Order, etc.
model CustomFieldDefinition {
  id              String   @id @default(uuid())
  entityName      String   @db.VarChar(100) // Product, Customer, Order, etc.
  fieldName       String   @db.VarChar(100)
  fieldLabel      String   @db.VarChar(255)
  fieldType       String   @db.VarChar(50) // text, number, boolean, date, datetime, select, multiselect, textarea
  dataType        String   @db.VarChar(50) // varchar, integer, decimal, boolean, date, timestamp, text, json
  length          Int?
  precision       Int?
  scale           Int?
  isRequired      Boolean  @default(false)
  isUnique        Boolean  @default(false)
  isIndexed       Boolean  @default(false)
  defaultValue    String?  @db.Text
  options         Json?    // For select/multiselect fields
  validationRules Json?    // min, max, pattern, custom
  displayOrder    Int      @default(0)
  helpText        String?  @db.Text
  placeholder     String?  @db.VarChar(255)
  tenantId        String?
  createdBy       String
  isActive        Boolean  @default(true)
  
  values          CustomFieldValue[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([entityName, fieldName, tenantId])
  @@index([entityName])
  @@index([tenantId])
  @@index([isActive])
}

// Custom Field Value Storage
// Stores actual values for custom fields on standard entities
model CustomFieldValue {
  id              String   @id @default(uuid())
  entityName      String   @db.VarChar(100)
  recordId        String   // ID of the record in the standard entity
  fieldName       String   @db.VarChar(100)
  value           Json     // Stores the field value
  tenantId        String?
  createdBy       String?
  
  fieldDefinition CustomFieldDefinition? @relation(fields: [entityName, fieldName, tenantId], references: [entityName, fieldName, tenantId])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([entityName, recordId, fieldName, tenantId])
  @@index([entityName, recordId])
  @@index([tenantId])
}

// Validation Rule Definition
// Defines validation rules that can be applied without code
model ValidationRule {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  entityName      String   @db.VarChar(100)
  ruleType        String   @db.VarChar(50) // field_validation, cross_field, record_validation
  condition       Json     // Condition expression
  errorMessage    String   @db.Text
  isActive        Boolean  @default(true)
  tenantId        String?
  createdBy       String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([entityName])
  @@index([tenantId])
  @@index([isActive])
}

// Formula Field Definition
// Defines calculated fields with formulas
model FormulaField {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(100)
  label           String   @db.VarChar(255)
  entityName      String   @db.VarChar(100)
  formula         String   @db.Text // Formula expression
  returnType      String   @db.VarChar(50) // number, text, boolean, date
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  tenantId        String?
  createdBy       String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([entityName, name, tenantId])
  @@index([entityName])
  @@index([tenantId])
  @@index([isActive])
}

// Business Rule Definition
// Defines business rules that execute on events
model BusinessRule {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  entityName      String   @db.VarChar(100)
  triggerEvent    String   @db.VarChar(50) // before_create, after_create, before_update, after_update, before_delete, after_delete
  condition       Json?    // Condition to evaluate
  actions         Json     // Array of actions to execute
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  tenantId        String?
  createdBy       String
  
  executions      BusinessRuleExecution[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([entityName])
  @@index([triggerEvent])
  @@index([tenantId])
  @@index([isActive])
}

// Business Rule Execution Log
model BusinessRuleExecution {
  id              String   @id @default(uuid())
  ruleId          String
  entityName      String   @db.VarChar(100)
  recordId        String
  status          String   @db.VarChar(50) // success, failure, skipped
  executionTime   Int      // milliseconds
  errorMessage    String?  @db.Text
  context         Json?    // Execution context
  
  rule            BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([ruleId])
  @@index([entityName, recordId])
  @@index([status])
  @@index([createdAt])
}

// Page Layout Definition
// Defines custom page layouts with drag-and-drop
model PageLayout {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  entityName      String   @db.VarChar(100)
  layoutType      String   @db.VarChar(50) // form, detail, list
  sections        Json     // Array of sections with fields and layout
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  tenantId        String?
  createdBy       String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([entityName])
  @@index([tenantId])
  @@index([isActive])
}

// ─── Zero-Trust Security Models (Task 38.1) ────────────────

// Trusted Device Registry
// Tracks devices that have been verified and trusted by users
model TrustedDevice {
  id              String   @id @default(uuid())
  deviceId        String   @unique @db.VarChar(255) // SHA-256 hash of device fingerprint
  userId          String
  deviceName      String?  @db.VarChar(255) // User-friendly name
  ipAddress       String   @db.VarChar(45)
  userAgent       String   @db.Text
  isTrusted       Boolean  @default(false) // Explicitly trusted by user
  trustScore      Int      @default(0) // 0-100 calculated trust score
  lastUsedAt      DateTime @default(now())
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([deviceId])
  @@index([lastUsedAt])
}

// Blocked IP Address Registry
// Tracks IP addresses that have been blocked due to suspicious activity
model BlockedIP {
  id              String   @id @default(uuid())
  ipAddress       String   @unique @db.VarChar(45)
  reason          String   @db.Text
  blockedBy       String   // User ID or "system"
  blockedAt       DateTime @default(now())
  expiresAt       DateTime? // Optional expiry for temporary blocks
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([ipAddress])
  @@index([isActive])
  @@index([expiresAt])
}

// Security Event Log
// Comprehensive logging of all security-related events for zero-trust monitoring
model SecurityEvent {
  id              String   @id @default(uuid())
  userId          String
  eventType       String   @db.VarChar(100) // ZERO_TRUST_VERIFICATION, UNAUTHORIZED_ACCESS_ATTEMPT, etc.
  resource        String?  @db.VarChar(255) // Resource being accessed
  action          String?  @db.VarChar(100) // Action being performed
  ipAddress       String   @db.VarChar(45)
  deviceId        String?  @db.VarChar(255)
  deviceTrustScore Int?    // Device trust score at time of event
  riskScore       Int?     // Risk score at time of event
  success         Boolean  @default(true)
  errorMessage    String?  @db.Text
  metadata        Json?    // Additional event metadata
  timestamp       DateTime @default(now())
  
  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@index([success])
  @@index([riskScore])
}

// User Account Lock Status
// Extends User model with account locking capability
model UserLockStatus {
  id              String   @id @default(uuid())
  userId          String   @unique
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  lastFailedAt    DateTime?
  lockReason      String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([lockedUntil])
}

// ─── Encryption & Key Management ───────────────────────────

// Encryption Key Management
// Stores metadata for encryption keys with automatic rotation
// Integrates with AWS KMS and Azure Key Vault for enterprise key management
model EncryptionKey {
  id              String   @id @default(uuid())
  keyId           String   @unique @db.VarChar(255) // Provider-specific key ID (KMS ARN, Key Vault ID, or local UUID)
  keyArn          String?  @db.VarChar(500) // AWS KMS ARN
  keyVaultUrl     String?  @db.VarChar(500) // Azure Key Vault URL
  keyName         String?  @db.VarChar(255) // Azure Key Vault key name
  
  type            String   @default("DATA_ENCRYPTION") @db.VarChar(50) // MASTER, DATA_ENCRYPTION, SIGNING, API
  provider        String   @default("LOCAL") @db.VarChar(50) // LOCAL, AWS_KMS, AZURE_KEY_VAULT
  algorithm       String   @default("aes-256-gcm") @db.VarChar(50)
  status          String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, ROTATING, EXPIRED, DISABLED, DELETED
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  
  // Rotation tracking (90-day rotation policy per Requirement 15.5)
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  lastRotatedAt   DateTime?
  nextRotationAt  DateTime
  rotationDays    Int      @default(90) // Configurable rotation period
  
  // Usage tracking
  usageCount      Int      @default(0)
  lastUsedAt      DateTime?
  
  // Audit trail
  auditLogs       KeyAuditLog[]
  accessLogs      KeyAccessLog[]
  
  updatedAt       DateTime @updatedAt
  
  @@index([status, isActive])
  @@index([expiresAt])
  @@index([nextRotationAt])
  @@index([type])
  @@index([provider])
}

// Key Audit Log
// Tracks all key management events for compliance
model KeyAuditLog {
  id              String   @id @default(uuid())
  keyId           String
  eventType       String   @db.VarChar(100) // KEY_CREATED, KEY_USED, KEY_ROTATED, KEY_REVOKED, KEY_DELETED
  usageType       String?  @db.VarChar(50) // ENCRYPTION, DECRYPTION, KEY_ROTATION, KEY_CREATION, KEY_DELETION
  success         Boolean  @default(true)
  errorMessage    String?  @db.Text
  metadata        Json?    // Additional event details
  
  // Context
  userId          String?
  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text
  
  timestamp       DateTime @default(now())
  
  key             EncryptionKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  
  @@index([keyId])
  @@index([eventType])
  @@index([usageType])
  @@index([timestamp])
  @@index([userId])
}

// Key Access Log
// Detailed audit trail for all key usage operations
model KeyAccessLog {
  id              String   @id @default(uuid())
  keyId           String
  key             EncryptionKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  
  action          String   @db.VarChar(50) // ENCRYPT, DECRYPT, ROTATE, CREATE, DELETE
  success         Boolean  @default(true)
  errorMessage    String?  @db.Text
  
  // Request context
  userId          String?
  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text
  
  // Performance metrics
  durationMs      Int?     // Operation duration in milliseconds
  dataSize        Int?     // Size of data encrypted/decrypted in bytes
  
  timestamp       DateTime @default(now())
  
  // Additional context
  metadata        Json?    // Additional context about the access
  
  @@index([keyId, timestamp])
  @@index([action, timestamp])
  @@index([userId, timestamp])
  @@index([success])
}

// System Configuration
// Stores system-wide configuration including key rotation policies
model SystemConfig {
  id              String   @id @default(uuid())
  key             String   @unique @db.VarChar(255)
  value           String?  @db.Text // JSON string
  description     String?  @db.Text
  isEncrypted     Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([key])
}

// Encrypted Field Metadata
// Tracks which fields are encrypted for transparent data encryption
model EncryptedFieldMetadata {
  id              String   @id @default(uuid())
  tableName       String   @db.VarChar(100)
  fieldName       String   @db.VarChar(100)
  encryptionType  String   @db.VarChar(50) // FULL, PARTIAL, MASKED
  keyId           String?  // Reference to encryption key used
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tableName, fieldName])
  @@index([tableName])
  @@index([isActive])
}

// ─── Help & Documentation ───────────────────────────────────────────────────

// Help Article (context-sensitive help system)
// Requirements: 28.1
model HelpArticle {
  id              String   @id @default(uuid())
  title           String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  summary         String?  @db.VarChar(500)
  content         String   // Full Markdown/HTML content

  // Context key ties an article to a specific page or module
  // e.g. "inventory.product-create", "pos.checkout", "crm.lead-list"
  contextKey      String   @db.VarChar(200)

  category        String   @db.VarChar(100)
  tags            String[] // Array of tag strings

  // Ordered list of related article IDs (stored as JSON array of UUIDs)
  relatedArticleIds Json   @default("[]")

  isPublished     Boolean  @default(false)
  isArchived      Boolean  @default(false)

  // Helpfulness tracking
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  viewCount       Int      @default(0)

  tenantId        String?
  createdBy       String?
  updatedBy       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contextKey])
  @@index([category])
  @@index([isPublished])
  @@index([tenantId])
}

// ─── Interactive Tutorials ──────────────────────────────────────────────────

// Tutorial definition — a named guided walkthrough
// Requirements: 28.3
model Tutorial {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  slug        String   @unique @db.VarChar(255)

  // Module/area this tutorial belongs to (e.g. "inventory", "pos", "orders")
  module      String   @db.VarChar(100)

  category    String   @db.VarChar(100)  // e.g. "getting-started", "advanced"
  tags        String[]

  // Order for display within a module
  sortOrder   Int      @default(0)

  isActive    Boolean  @default(true)

  steps       TutorialStep[]
  userProgress UserTutorialProgress[]

  tenantId    String?
  createdBy   String?
  updatedBy   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module])
  @@index([category])
  @@index([isActive])
  @@index([tenantId])
}

// Individual step within a tutorial
// Requirements: 28.3
model TutorialStep {
  id           String   @id @default(uuid())
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  stepNumber   Int      // 1-based order within the tutorial

  title        String   @db.VarChar(255)
  content      String   // Instruction text (Markdown supported)
  mediaUrl     String?  @db.VarChar(500) // Optional image/video URL

  // DOM selector used by the frontend to highlight a UI element
  targetSelector String? @db.VarChar(500)

  // Tooltip placement relative to the target: top | bottom | left | right | center
  placement    String   @default("bottom") @db.VarChar(20)

  // Optional action the user must perform before proceeding (click, input, etc.)
  actionType   String?  @db.VarChar(50)

  // Page/route where this step applies
  route        String?  @db.VarChar(255)

  stepProgresses UserTutorialStepProgress[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tutorialId, stepNumber])
  @@index([tutorialId])
}

// Per-user overall progress for a tutorial
// Requirements: 28.3
model UserTutorialProgress {
  id           String   @id @default(uuid())
  userId       String
  tutorialId   String
  tutorial     Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  // Status: not_started | in_progress | completed | skipped
  status       String   @default("not_started") @db.VarChar(30)

  currentStep  Int      @default(1)
  completedAt  DateTime?
  startedAt    DateTime?

  stepProgresses UserTutorialStepProgress[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, tutorialId])
  @@index([userId])
  @@index([tutorialId])
  @@index([status])
}

// Per-user per-step completion record
// Requirements: 28.3
model UserTutorialStepProgress {
  id             String               @id @default(uuid())
  userId         String
  progressId     String
  progress       UserTutorialProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  stepId         String
  step           TutorialStep         @relation(fields: [stepId], references: [id], onDelete: Cascade)

  completedAt    DateTime             @default(now())

  @@unique([progressId, stepId])
  @@index([userId])
  @@index([progressId])
  @@index([stepId])
}

// ─── Video Training Library ─────────────────────────────────────────────────

// Training video metadata stored in the catalogue
// Requirements: 28.4
model TrainingVideo {
  id           String   @id @default(uuid())

  title        String   @db.VarChar(255)
  description  String   @db.VarChar(1000)

  // Module/area this video belongs to (e.g. "dashboard", "pos", "inventory")
  module       String   @db.VarChar(100)

  // Formatted duration string, e.g. "4:32"
  duration     String   @db.VarChar(20)

  // Absolute or relative URL to the video (YouTube embed, Vimeo, or direct file)
  videoUrl     String   @db.VarChar(500)

  // Thumbnail image URL (YouTube auto-thumb, custom upload, etc.)
  thumbnailUrl String?  @db.VarChar(500)

  // Tag keywords for search
  tags         String[]

  // Difficulty level: beginner | intermediate | advanced
  level        String   @default("beginner") @db.VarChar(20)

  // Display order within the module
  sortOrder    Int      @default(0)

  isActive     Boolean  @default(true)

  tenantId     String?
  createdBy    String?
  updatedBy    String?

  viewCount    Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([module])
  @@index([isActive])
  @@index([tenantId])
}

// ─── Release Notes ──────────────────────────────────────────────────────────
// Changelog entries for each NexaERP system update.
// Requirements: 28.6
model ReleaseNote {
  id          String   @id @default(uuid())
  version     String   @db.VarChar(20)   // semver, e.g. "1.2.0"
  title       String   @db.VarChar(255)
  releaseDate DateTime
  summary     String   @db.VarChar(1000)
  // Release type: major | minor | patch
  type        String   @default("minor") @db.VarChar(10)
  // JSON array of { category: string, items: string[] }
  sections    Json     @default("[]")
  isPublished Boolean  @default(false)
  createdBy   String?
  tenantId    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([version])
  @@index([isPublished])
  @@index([releaseDate])
  @@index([tenantId])
}

// ─── Community Forum ────────────────────────────────────────────────────────
// Requirements: 28.8

model ForumThread {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  content     String   @db.Text
  /// General | Features | Bug Reports | How-To | Announcements
  category    String   @db.VarChar(50)
  authorId    String
  authorName  String   @db.VarChar(100)
  tags        String[]
  viewCount   Int      @default(0)
  replyCount  Int      @default(0)
  isAnswered  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  isClosed    Boolean  @default(false)
  isPublished Boolean  @default(true)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies     ForumReply[]

  @@index([category])
  @@index([authorId])
  @@index([tenantId])
  @@index([isPublished])
  @@index([isPinned])
  @@index([createdAt])
}

model ForumReply {
  id               String      @id @default(uuid())
  threadId         String
  thread           ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content          String      @db.Text
  authorId         String
  authorName       String      @db.VarChar(100)
  isAcceptedAnswer Boolean     @default(false)
  isPublished      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([threadId])
  @@index([authorId])
  @@index([isAcceptedAnswer])
}
