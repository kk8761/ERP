  eventDescription    String   @db.Text
  
  createdAt           DateTime @default(now())
  
  // Relations to dimensions
  date                DimDate     @relation(fields: [dateKey], references: [dateKey])
  employee            DimEmployee @relation(fields: [employeeKey], references: [employeeKey])
  
  @@index([dateKey])
  @@index([employeeKey])
  @@index([eventType])
