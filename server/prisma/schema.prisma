  productionOrderId String   @db.VarChar(100)
  workCenterId      String   @db.VarChar(100)
  operationId       String   @db.VarChar(100)
  operationName     String   @db.VarChar(255)
  status            String   @db.VarChar(50) // planned, ready, in_progress, paused, completed, cancelled
  startTime         DateTime?
  endTime           DateTime?
  plannedDuration   Int      // minutes
  actualDuration    Int?     // minutes
  operatorId        String?  @db.VarChar(100)
  operatorName      String?  @db.VarChar(255)
  efficiency        Float?   // percentage
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([productionOrderId])
  @@index([workCenterId])
  @@index([status])
  @@index([operatorId])
}

// IoT Device Registry
model IoTDevice {
  id            String   @id @default(uuid())
  deviceId      String   @unique @db.VarChar(100)
  deviceName    String   @db.VarChar(255)
  deviceType    String   @db.VarChar(100)
  workCenterId  String?  @db.VarChar(100)
  assetId       String?  @db.VarChar(100)
  status        String   @default("offline") @db.VarChar(50) // online, offline, error, maintenance
  lastHeartbeat DateTime?
  configuration Json?    // Device-specific configuration
  location      String?  @db.VarChar(255)
  
  sensorMetrics SensorMetric[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([deviceId])
  @@index([workCenterId])
  @@index([assetId])
  @@index([status])
}

// Sensor Data (Time-Series)
model SensorMetric {
  id          String   @id @default(uuid())
  deviceId    String
  metricName  String   @db.VarChar(100)
  metricValue Float
  unit        String   @db.VarChar(50)
  timestamp   DateTime
  quality     String?  @db.VarChar(20) // good, bad, uncertain
  metadata    Json?    // Additional metric metadata
  
  device      IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@index([deviceId, timestamp])
  @@index([metricName, timestamp])
  @@index([timestamp])
}

// Equipment Health Monitoring
model EquipmentHealth {
  id                  String   @id @default(uuid())
  assetId             String   @db.VarChar(100)
  assetName           String   @db.VarChar(255)
  healthScore         Float    // 0-100
  predictedFailureDate DateTime?
  remainingUsefulLife Int?     // days
  algorithm           String   @db.VarChar(100) // ML algorithm used
  confidence          Float?   // prediction confidence 0-1
  recommendations     Json?    // Array of recommended actions
  sensorData          Json?    // Recent sensor readings used for prediction
  
  maintenanceTasks    PredictiveMaintenanceTask[]
  
  calculatedAt        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([assetId])
  @@index([healthScore])
  @@index([predictedFailureDate])
}

// Predictive Maintenance Tasks
model PredictiveMaintenanceTask {
  id                String   @id @default(uuid())
  taskNumber        String   @unique @db.VarChar(100)
  equipmentHealthId String
  assetId           String   @db.VarChar(100)
  taskType          String   @db.VarChar(100) // inspection, repair, replacement
  priority          String   @db.VarChar(50) // low, medium, high, critical
  description       String   @db.Text
  scheduledDate     DateTime
  completedDate     DateTime?
  status            String   @default("scheduled") @db.VarChar(50) // scheduled, in_progress, completed, cancelled
  assignedTo        String?  @db.VarChar(255)
  estimatedCost     Float?
  actualCost        Float?
  notes             String?  @db.Text
  
  equipmentHealth   EquipmentHealth @relation(fields: [equipmentHealthId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([assetId])
  @@index([status])
  @@index([scheduledDate])
  @@index([priority])
}

// Digital Twin Models
model DigitalTwin {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  physicalAssetId String   @db.VarChar(100)
  modelType       String   @db.VarChar(100)
  modelVersion    String   @db.VarChar(50)
  parameters      Json     // Model parameters
  state           Json     // Current state
  lastSyncTime    DateTime?
  isActive        Boolean  @default(true)
  
  simulations     Simulation[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([physicalAssetId])
  @@index([isActive])
}

// Simulation Runs
model Simulation {
  id              String   @id @default(uuid())
  digitalTwinId   String
  simulationName  String   @db.VarChar(255)
  simulationType  String   @db.VarChar(100)
  inputParameters Json     // Input parameters for simulation
  outputResults   Json     // Simulation results
  startTime       DateTime
  endTime         DateTime?
  duration        Int?     // seconds
  status          String   @db.VarChar(50) // running, completed, failed, cancelled
  errorMessage    String?  @db.Text
  
  digitalTwin     DigitalTwin @relation(fields: [digitalTwinId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([digitalTwinId])
  @@index([status])
  @@index([startTime])
}

// OEE (Overall Equipment Effectiveness) Metrics
model OEEMetrics {
  id                      String   @id @default(uuid())
  workCenterId            String   @db.VarChar(100)
  assetId                 String?  @db.VarChar(100)
  startDate               DateTime
  endDate                 DateTime
  
  // Availability metrics
  plannedProductionTime   Int      // minutes
  actualProductionTime    Int      // minutes
  downtime                Int      // minutes
  availability            Float    // percentage
  
  // Performance metrics
  idealCycleTime          Float    // minutes per unit
  totalUnitsProduced      Int
  performanceRate         Float    // percentage
  
  // Quality metrics
  goodUnits               Int
  defectiveUnits          Int
  qualityRate             Float    // percentage
  
  // Overall OEE
  oee                     Float    // percentage
  
  calculatedAt            DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  @@index([workCenterId, startDate])
  @@index([assetId, startDate])
  @@index([calculatedAt])
}

// Production Monitoring Dashboard Data
model ProductionStatus {
  id                    String   @id @default(uuid())
  workCenterId          String   @unique @db.VarChar(100)
  workCenterName        String   @db.VarChar(255)
  status                String   @db.VarChar(50) // idle, running, paused, maintenance, breakdown
  currentOperationId    String?  @db.VarChar(100)
  currentProductionOrder String? @db.VarChar(100)
  currentProduct        String?  @db.VarChar(255)
  unitsProduced         Int      @default(0)
  targetUnits           Int      @default(0)
  efficiency            Float    @default(0)
  alerts                Json?    // Array of production alerts
  lastUpdated           DateTime @default(now())
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([workCenterId])
  @@index([status])
}

// Production Alerts
model ProductionAlert {
  id            String   @id @default(uuid())
  workCenterId  String   @db.VarChar(100)
  severity      String   @db.VarChar(50) // info, warning, error, critical
  message       String   @db.Text
  timestamp     DateTime @default(now())
  acknowledged  Boolean  @default(false)
  acknowledgedBy String? @db.VarChar(255)
  acknowledgedAt DateTime?
  resolved      Boolean  @default(false)
  resolvedBy    String?  @db.VarChar(255)
  resolvedAt    DateTime?
  metadata      Json?    // Additional alert metadata
  notes         String?  @db.Text
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([workCenterId, acknowledged])
  @@index([severity, acknowledged])
  @@index([timestamp])
}

// Production Scheduling Optimization
model ProductionSchedule {
  id                String   @id @default(uuid())
  scheduleNumber    String   @unique @db.VarChar(100)
  startDate         DateTime
  endDate           DateTime
  status            String   @default("draft") @db.VarChar(50) // draft, optimized, published, active, completed
  optimizationGoal  String   @db.VarChar(100) // minimize_makespan, maximize_throughput, balance_load
  constraints       Json?    // Scheduling constraints
  schedule          Json     // Optimized schedule data
  makespan          Int?     // Total time to complete all orders (minutes)
  throughput        Float?   // Units per hour
  utilizationRate   Float?   // Average work center utilization
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([status])
  @@index([startDate])
}

// ─── Financial Consolidation Module ────────────────────────

// Company/Entity model for multi-entity consolidation
model Company {
  id                    String   @id @default(uuid())
  companyCode           String   @unique @db.VarChar(50)
  name                  String   @db.VarChar(255)
  legalName             String   @db.VarChar(255)
  taxId                 String?  @db.VarChar(100)
  currency              String   @default("USD") @db.VarChar(10)
  fiscalYearEnd         String   @db.VarChar(10) // MM-DD format
  isActive              Boolean  @default(true)
  
  // Consolidation hierarchy
  parentCompanyId       String?
  parentCompany         Company? @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  subsidiaries          Company[] @relation("CompanyHierarchy")
  
  // Ownership percentage for consolidation
  ownershipPercentage   Float?   @default(100) // 0-100
  consolidationMethod   String?  @db.VarChar(50) // full, proportional, equity
  
  // Relationships
  consolidationGroupMemberships ConsolidationGroupMember[]
  intercompanyTransactionsFrom  IntercompanyTransaction[] @relation("FromCompany")
  intercompanyTransactionsTo    IntercompanyTransaction[] @relation("ToCompany")
  consolidations                Consolidation[] @relation("ParentCompanyConsolidations")
  subsidiaryConsolidations      ConsolidationSubsidiary[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([parentCompanyId])
  @@index([isActive])
}

// Consolidation Group model
model ConsolidationGroup {
  id                    String   @id @default(uuid())
  name                  String   @db.VarChar(255)
  description           String?  @db.Text
  groupType             String   @db.VarChar(50) // legal, management, reporting
  isActive              Boolean  @default(true)
  
  // Relationships
  members               ConsolidationGroupMember[]
  consolidations        Consolidation[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([isActive])
}

// Junction table for consolidation group membership
model ConsolidationGroupMember {
  id                    String   @id @default(uuid())
  groupId               String
  companyId             String
  role                  String   @db.VarChar(50) // parent, subsidiary, associate
  effectiveDate         DateTime @db.Date
  endDate               DateTime? @db.Date
  
  group                 ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  company               Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([groupId, companyId, effectiveDate])
  @@index([groupId])
  @@index([companyId])
}

// Consolidation run model
model Consolidation {
  id                    String   @id @default(uuid())
  consolidationNumber   String   @unique @db.VarChar(100)
  consolidationDate     DateTime @db.Date
  periodStart           DateTime @db.Date
  periodEnd             DateTime @db.Date
  
  // Parent company and group
  parentCompanyId       String
  parentCompany         Company @relation("ParentCompanyConsolidations", fields: [parentCompanyId], references: [id])
  
  consolidationGroupId  String?
  consolidationGroup    ConsolidationGroup? @relation(fields: [consolidationGroupId], references: [id])
  
  // Status and metadata
  status                String   @default("draft") // draft, in_progress, completed, approved
  consolidationMethod   String   @db.VarChar(50) // full, proportional, equity
  
  // Financial totals (consolidated)
  totalRevenue          Float    @default(0)
  totalExpenses         Float    @default(0)
  totalAssets           Float    @default(0)
  totalLiabilities      Float    @default(0)
  totalEquity           Float    @default(0)
  netIncome             Float    @default(0)
  
  // Elimination totals
  totalEliminations     Float    @default(0)
  
  // Relationships
  subsidiaries          ConsolidationSubsidiary[]
  eliminationEntries    EliminationEntry[]
  
  // Audit fields
  createdBy             String
  approvedBy            String?
  approvedAt            DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([parentCompanyId, consolidationDate])
  @@index([status])
  @@index([consolidationDate])
}

// Subsidiary data in consolidation
model ConsolidationSubsidiary {
  id                    String   @id @default(uuid())
  consolidationId       String
  companyId             String
  
  // Ownership and method
  ownershipPercentage   Float    // 0-100
  consolidationMethod   String   @db.VarChar(50) // full, proportional, equity
  
  // Financial data from subsidiary
  revenue               Float    @default(0)
  expenses              Float    @default(0)
  assets                Float    @default(0)
  liabilities           Float    @default(0)
  equity                Float    @default(0)
  netIncome             Float    @default(0)
  
  // Consolidated amounts (after ownership %)
  consolidatedRevenue   Float    @default(0)
  consolidatedExpenses  Float    @default(0)
  consolidatedAssets    Float    @default(0)
  consolidatedLiabilities Float  @default(0)
  consolidatedEquity    Float    @default(0)
  consolidatedNetIncome Float    @default(0)
  
  // Minority interest (for partial ownership)
  minorityInterest      Float    @default(0)
  
  consolidation         Consolidation @relation(fields: [consolidationId], references: [id], onDelete: Cascade)
  company               Company @relation(fields: [companyId], references: [id])
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([consolidationId, companyId])
  @@index([consolidationId])
  @@index([companyId])
}

// Intercompany transaction tracking
model IntercompanyTransaction {
  id                    String   @id @default(uuid())
  transactionNumber     String   @unique @db.VarChar(100)
  transactionDate       DateTime @db.Date
  
  // Companies involved
  fromCompanyId         String
  toCompanyId           String
  fromCompany           Company @relation("FromCompany", fields: [fromCompanyId], references: [id])
  toCompany             Company @relation("ToCompany", fields: [toCompanyId], references: [id])
  
  // Transaction details
  transactionType       String   @db.VarChar(50) // sale, purchase, loan, dividend, service
  description           String   @db.Text
  amount                Float
  currency              String   @default("USD") @db.VarChar(10)
  
  // GL accounts involved
  fromAccountId         String?  // Receivable/Asset account in from company
  toAccountId           String?  // Payable/Liability account in to company
  
  // Elimination status
  requiresElimination   Boolean  @default(true)
  isEliminated          Boolean  @default(false)
  eliminationEntryId    String?
  
  // Reference to source documents
  sourceDocumentType    String?  @db.VarChar(50) // invoice, journal_entry, payment
  sourceDocumentId      String?
  
  // Relationships
  eliminationEntry      EliminationEntry? @relation(fields: [eliminationEntryId], references: [id])
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([fromCompanyId, toCompanyId])
  @@index([transactionDate])
  @@index([isEliminated])
  @@index([transactionType])
}

// Elimination entries for consolidation
model EliminationEntry {
  id                    String   @id @default(uuid())
  entryNumber           String   @unique @db.VarChar(100)
  consolidationId       String
  
  // Entry details
  entryDate             DateTime @db.Date
  description           String   @db.Text
  eliminationType       String   @db.VarChar(50) // intercompany_sale, intercompany_loan, dividend, investment
  
  // Total elimination amount
  totalAmount           Float
  
  // Status
  status                String   @default("draft") // draft, posted, reversed
  
  // Relationships
  consolidation         Consolidation @relation(fields: [consolidationId], references: [id], onDelete: Cascade)
  lines                 EliminationLine[]
  intercompanyTransactions IntercompanyTransaction[]
  
  // Audit fields
  createdBy             String
  postedBy              String?
  postedAt              DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([consolidationId])
  @@index([status])
  @@index([entryDate])
}

// Elimination entry lines (journal lines for elimination)
model EliminationLine {
  id                    String   @id @default(uuid())
  eliminationEntryId    String
  
  // Account and amounts
  accountCode           String   @db.VarChar(50)
  accountName           String   @db.VarChar(255)
  debit                 Float    @default(0)
  credit                Float    @default(0)
  description           String?  @db.Text
  
  // Company context
  companyId             String?  // Which company's books this affects
  
  eliminationEntry      EliminationEntry @relation(fields: [eliminationEntryId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())
  
  @@index([eliminationEntryId])
  @@index([accountCode])
}

// ─── Multi-Currency Support ────────────────────────────────

model Currency {
  id              String   @id @default(uuid())
  code            String   @unique @db.VarChar(10) // ISO 4217 currency code (e.g., USD, EUR, GBP)
  name            String   @db.VarChar(100) // Full name (e.g., US Dollar)
  symbol          String   @db.VarChar(10) // Currency symbol (e.g., $, €, £)
  decimalPlaces   Int      @default(2) // Number of decimal places
  isActive        Boolean  @default(true)
  isBaseCurrency  Boolean  @default(false) // Only one currency should be base
  
  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")
  currencyGainsLosses CurrencyGainLoss[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isActive])
  @@index([isBaseCurrency])
}

model ExchangeRate {
  id              String   @id @default(uuid())
  fromCurrencyId  String
  fromCurrency    Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Cascade)
  
  toCurrencyId    String
  toCurrency      Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id], onDelete: Cascade)
  
  rate            Float    // Exchange rate (1 fromCurrency = rate * toCurrency)
  effectiveDate   DateTime @db.Date
  expiryDate      DateTime? @db.Date // Optional expiry date
  source          String   @default("manual") @db.VarChar(50) // manual, api, system
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([effectiveDate])
  @@index([isActive])
}

model CurrencyGainLoss {
  id              String   @id @default(uuid())
  transactionType String   @db.VarChar(50) // invoice, payment, revaluation
  transactionId   String   @db.VarChar(100) // Reference to the transaction
  
  currencyId      String
  currency        Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  
  originalAmount  Float    // Amount in foreign currency
  originalRate    Float    // Exchange rate at transaction date
  settlementAmount Float?  // Amount at settlement (for realized gains/losses)
  settlementRate  Float?   // Exchange rate at settlement date
  
  gainLossAmount  Float    // Calculated gain/loss in base currency
  gainLossType    String   @db.VarChar(20) // realized, unrealized
  
  transactionDate DateTime
  settlementDate  DateTime?
  
  // GL Account for posting
  glAccountId     String?  @db.VarChar(100)
  journalEntryId  String?  @db.VarChar(100) // Link to generated journal entry
  
  fiscalPeriod    String   @db.VarChar(20)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([transactionType, transactionId])
  @@index([currencyId])
  @@index([gainLossType])
  @@index([fiscalPeriod])
  @@index([transactionDate])
}


// ─── Treasury Management Module ────────────────────────────

// Cash Account model for tracking cash positions
model CashAccount {
  id                String   @id @default(uuid())
  accountNumber     String   @unique @db.VarChar(100)
  accountName       String   @db.VarChar(255)
  bankName          String   @db.VarChar(255)
  bankBranch        String?  @db.VarChar(255)
  accountType       String   @db.VarChar(50) // checking, savings, money_market, petty_cash
  currency          String   @db.VarChar(10) // ISO 4217 currency code
  
  // Balance tracking
  currentBalance    Float    @default(0)
  availableBalance  Float    @default(0) // After pending transactions
  
  // Account details
  swiftCode         String?  @db.VarChar(50)
  iban              String?  @db.VarChar(100)
  routingNumber     String?  @db.VarChar(50)
  
  // Status
  isActive          Boolean  @default(true)
  openDate          DateTime @db.Date
  closeDate         DateTime? @db.Date
  
  // GL Integration
  glAccountId       String?  @db.VarChar(100) // Link to GL account
  
  // Relationships
  transactions      CashTransaction[]
  forecasts         CashFlowForecast[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([accountType])
  @@index([currency])
  @@index([isActive])
}

// Cash Transaction model for tracking cash movements
model CashTransaction {
  id                String   @id @default(uuid())
  transactionNumber String   @unique @db.VarChar(100)
  cashAccountId     String
  cashAccount       CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  
  transactionDate   DateTime @db.Date
  valueDate         DateTime @db.Date // When funds are actually available
  transactionType   String   @db.VarChar(50) // deposit, withdrawal, transfer, interest, fee
  
  amount            Float
  currency          String   @db.VarChar(10)
  
  // Transaction details
  description       String   @db.Text
  reference         String?  @db.VarChar(255)
  counterparty      String?  @db.VarChar(255)
  
  // Categorization
  category          String?  @db.VarChar(100) // operating, investing, financing
  subcategory       String?  @db.VarChar(100)
  
  // Status
  status            String   @default("pending") @db.VarChar(50) // pending, cleared, reconciled, cancelled
  
  // Links
  sourceDocumentType String? @db.VarChar(50) // invoice, payment, journal_entry
  sourceDocumentId  String?  @db.VarChar(100)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([cashAccountId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([status])
}

// Investment model for tracking investments
model Investment {
  id                String   @id @default(uuid())
  investmentNumber  String   @unique @db.VarChar(100)
  investmentName    String   @db.VarChar(255)
  investmentType    String   @db.VarChar(50) // bond, stock, mutual_fund, cd, treasury_bill, money_market
  
  // Investment details
  issuer            String?  @db.VarChar(255)
  cusip             String?  @db.VarChar(50) // Security identifier
  isin              String?  @db.VarChar(50) // International security identifier
  
  // Amounts
  principalAmount   Float
  currentValue      Float
  currency          String   @db.VarChar(10)
  
  // Dates
  purchaseDate      DateTime @db.Date
  maturityDate      DateTime? @db.Date
  
  // Returns
  interestRate      Float?   // Annual interest rate percentage
  yieldRate         Float?   // Current yield percentage
  
  // Status
  status            String   @default("active") @db.VarChar(50) // active, matured, sold, redeemed
  
  // GL Integration
  glAccountId       String?  @db.VarChar(100)
  
  // Relationships
  transactions      InvestmentTransaction[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([investmentType])
  @@index([status])
  @@index([maturityDate])
}

// Investment Transaction model
model InvestmentTransaction {
  id                String   @id @default(uuid())
  investmentId      String
  investment        Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  
  transactionDate   DateTime @db.Date
  transactionType   String   @db.VarChar(50) // purchase, sale, interest, dividend, redemption, valuation
  
  amount            Float
  units             Float?   // Number of shares/units
  pricePerUnit      Float?
  currency          String   @db.VarChar(10)
  
  description       String?  @db.Text
  
  createdAt         DateTime @default(now())
  
  @@index([investmentId])
  @@index([transactionDate])
  @@index([transactionType])
}

// Loan model for tracking loans (both borrowed and lent)
model Loan {
  id                String   @id @default(uuid())
  loanNumber        String   @unique @db.VarChar(100)
  loanName          String   @db.VarChar(255)
  loanType          String   @db.VarChar(50) // term_loan, line_of_credit, mortgage, bond, note_payable, note_receivable
  
  // Loan direction
  direction         String   @db.VarChar(50) // borrowed, lent
  
  // Parties
  lender            String?  @db.VarChar(255)
  borrower          String?  @db.VarChar(255)
  
  // Amounts
  principalAmount   Float
  outstandingBalance Float
  currency          String   @db.VarChar(10)
  
  // Terms
  interestRate      Float    // Annual interest rate percentage
  interestType      String   @db.VarChar(50) // fixed, variable
  
  // Dates
  originationDate   DateTime @db.Date
  maturityDate      DateTime @db.Date
  firstPaymentDate  DateTime? @db.Date
  
  // Payment terms
  paymentFrequency  String   @db.VarChar(50) // monthly, quarterly, semi_annual, annual
  paymentAmount     Float?
  
  // Collateral
  isSecured         Boolean  @default(false)
  collateralDescription String? @db.Text
  
  // Status
  status            String   @default("active") @db.VarChar(50) // active, paid_off, defaulted, refinanced
  
  // GL Integration
  glAccountId       String?  @db.VarChar(100)
  
  // Relationships
  payments          LoanPayment[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([loanType])
  @@index([direction])
  @@index([status])
  @@index([maturityDate])
}

// Loan Payment model
model LoanPayment {
  id                String   @id @default(uuid())
  loanId            String
  loan              Loan     @relation(fields: [loanId], references: [id], onDelete: Restrict)
  
  paymentDate       DateTime @db.Date
  dueDate           DateTime @db.Date
  
  // Payment breakdown
  paymentAmount     Float
  principalAmount   Float
  interestAmount    Float
  feesAmount        Float    @default(0)
  
  currency          String   @db.VarChar(10)
  
  // Status
  status            String   @default("scheduled") @db.VarChar(50) // scheduled, paid, late, missed
  
  // Links
  paymentReference  String?  @db.VarChar(255)
  journalEntryId    String?  @db.VarChar(100)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([loanId])
  @@index([paymentDate])
  @@index([dueDate])
  @@index([status])
}

// Cash Flow Forecast model
model CashFlowForecast {
  id                String   @id @default(uuid())
  forecastNumber    String   @unique @db.VarChar(100)
  forecastName      String   @db.VarChar(255)
  
  // Forecast period
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  frequency         String   @db.VarChar(50) // daily, weekly, monthly
  
  // Scope
  cashAccountId     String?  // Specific account or null for all accounts
  cashAccount       CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  currency          String   @db.VarChar(10)
  
  // Forecast data
  forecastData      Json     // Array of forecast periods with inflows, outflows, net, balance
  
  // Accuracy tracking
  actualData        Json?    // Actual results for comparison
  accuracy          Float?   // Forecast accuracy percentage
  
  // Methodology
  method            String   @db.VarChar(50) // direct, indirect, statistical, ml
  assumptions       String?  @db.Text
  
  // Status
  status            String   @default("draft") @db.VarChar(50) // draft, published, archived
  
  createdBy         String
  approvedBy        String?
  approvedAt        DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([startDate, endDate])
  @@index([status])
  @@index([currency])
}

// Treasury Position Snapshot model
model TreasuryPosition {
  id                String   @id @default(uuid())
  snapshotDate      DateTime @db.Date
  currency          String   @db.VarChar(10)
  
  // Cash positions
  totalCash         Float    @default(0)
  cashByAccount     Json     // Array of {accountId, accountName, balance}
  
  // Investment positions
  totalInvestments  Float    @default(0)
  investmentsByType Json     // Array of {type, count, totalValue}
  
  // Loan positions
  totalLoansReceivable Float @default(0)
  totalLoansPayable Float    @default(0)
  loansByType       Json     // Array of {type, direction, count, totalBalance}
  
  // Liquidity metrics
  totalLiquidity    Float    @default(0) // Cash + liquid investments
  netDebtPosition   Float    @default(0) // Loans payable - loans receivable
  
  // Risk metrics
  currencyExposure  Json?    // Foreign currency exposure by currency
  interestRateRisk  Float?   // Sensitivity to interest rate changes
  
  // Metadata
  generatedBy       String
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  
  @@unique([snapshotDate, currency])
  @@index([snapshotDate])
  @@index([currency])
}

// Risk Reports model
model RiskReport {
  id            String   @id @default(uuid())
  reportDate    DateTime @db.Date
  reportType    String   @db.VarChar(50) // currency, interest_rate, credit, comprehensive
  currency      String   @db.VarChar(10)
  
  // Report data (stored as JSON)
  reportData    Json     // Complete risk report with all metrics
  
  // Metadata
  generatedBy   String
  
  createdAt     DateTime @default(now())
  
  @@index([reportDate])
  @@index([reportType])
  @@index([currency])
  @@index([reportType, currency, reportDate])
}


// ─── Tax Engine Integration Module ─────────────────────────

// Tax Rule model for internal tax calculation
model TaxRule {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  
  // Geographic scope
  country         String   @db.VarChar(2) // ISO country code
  state           String?  @db.VarChar(100)
  city            String?  @db.VarChar(100)
  postalCode      String?  @db.VarChar(20)
  jurisdiction    String?  @db.VarChar(255)
  
  // Tax configuration
  taxType         String   @db.VarChar(50) // vat, gst, sales_tax, excise, customs, other
  rate            Float    // Tax rate as percentage
  
  // Applicability
  productCategory String?  @db.VarChar(100)
  taxCode         String?  @db.VarChar(50) // Product tax category code
  
  // Priority and status
  priority        Int      @default(0) // Higher priority rules are applied first
  isActive        Boolean  @default(true)
  
  // Effective dates
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([country, state, isActive])
  @@index([taxType, isActive])
  @@index([effectiveFrom, effectiveTo])
}

// Tax Calculation model for audit trail
model TaxCalculation {
  id                      String   @id @default(uuid())
  
  // Transaction reference
  transactionId           String?  @db.VarChar(100)
  transactionType         String   @db.VarChar(50) // invoice, order, quote
  
  // Tax engine details
  taxEngineProvider       String   @db.VarChar(50) // avalara, vertex, internal
  taxEngineTransactionId  String?  @db.VarChar(255)
  
  // Calculation results
  totalTax                Float
  taxableAmount           Float
  exemptAmount            Float    @default(0)
  currency                String   @db.VarChar(3)
  
  // Geographic information
  customerCountry         String   @db.VarChar(2)
  customerState           String?  @db.VarChar(100)
  sellerCountry           String   @db.VarChar(2)
  sellerState             String?  @db.VarChar(100)
  
  // Audit trail
  calculationDate         DateTime @default(now())
  requestData             String   @db.Text // JSON of request
  responseData            String   @db.Text // JSON of response
  
  createdAt               DateTime @default(now())
  
  @@index([transactionId, transactionType])
  @@index([taxEngineProvider])
  @@index([calculationDate])
  @@index([customerCountry, customerState])
}

// Tax Configuration model for storing tax engine settings
model TaxConfiguration {
  id                String   @id @default(uuid())
  
  // Configuration key-value pairs
  configKey         String   @unique @db.VarChar(100)
  configValue       String   @db.Text
  description       String?  @db.Text
  
  // Metadata
  isEncrypted       Boolean  @default(false)
  isActive          Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([configKey, isActive])
}

// Tax Exemption model for tracking tax-exempt customers/products
model TaxExemption {
  id                String   @id @default(uuid())
  
  // Exemption details
  exemptionType     String   @db.VarChar(50) // customer, product, transaction
  entityId          String   @db.VarChar(100) // Customer ID, Product ID, etc.
  entityType        String   @db.VarChar(50) // customer, product
  
  // Exemption certificate
  certificateNumber String?  @db.VarChar(100)
  certificateType   String?  @db.VarChar(100)
  issuingAuthority  String?  @db.VarChar(255)
  
  // Geographic scope
  country           String?  @db.VarChar(2)
  state             String?  @db.VarChar(100)
  
  // Tax types covered
  taxTypes          String   @db.Text // JSON array of tax types
  
  // Validity
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  isActive          Boolean  @default(true)
  
  // Documentation
  documentUrl       String?  @db.Text
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([entityId, entityType, isActive])
  @@index([certificateNumber])
  @@index([effectiveFrom, effectiveTo])
}

// ─── Global Enterprise Features Module ────────────────────

// Localization model for country-specific settings
model Localization {
  id                String   @id @default(uuid())
  
  // Country and language
  countryCode       String   @unique @db.VarChar(2) // ISO 3166-1 alpha-2
  countryName       String   @db.VarChar(255)
  languageCode      String   @db.VarChar(10) // e.g., "en-US", "fr-FR"
  languageName      String   @db.VarChar(100)
  
  // Currency settings
  currencyCode      String   @db.VarChar(3) // ISO 4217
  currencySymbol    String   @db.VarChar(10)
  currencyFormat    String   @db.VarChar(50) // e.g., "$1,234.56", "1.234,56 €"
  decimalSeparator  String   @db.VarChar(1) // "." or ","
  thousandSeparator String   @db.VarChar(1) // "," or "."
  
  // Date and time formatting
  dateFormat        String   @db.VarChar(50) // e.g., "MM/DD/YYYY", "DD.MM.YYYY"
  timeFormat        String   @db.VarChar(50) // e.g., "HH:mm:ss", "hh:mm:ss A"
  timezone          String   @db.VarChar(100) // IANA timezone
  firstDayOfWeek    Int      @default(0) // 0=Sunday, 1=Monday
  
  // Number formatting
  numberFormat      String   @db.VarChar(50) // e.g., "1,234.56", "1.234,56"
  
  // Tax and compliance
  defaultTaxType    String?  @db.VarChar(50) // VAT, GST, Sales Tax
  taxIdLabel        String?  @db.VarChar(100) // e.g., "VAT Number", "GST Number"
  
  // Address format
  addressFormat     String   @db.Text // JSON template for address formatting
  postalCodeFormat  String?  @db.VarChar(50) // Regex pattern for postal code
  
  // Metadata
  isActive          Boolean  @default(true)
  notes             String?  @db.Text
  
  // Relations
  translations      Translation[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([countryCode, isActive])
  @@index([languageCode])
}

// Translation model for multi-language support
model Translation {
  id                String   @id @default(uuid())
  
  // Translation key and value
  translationKey    String   @db.VarChar(255) // e.g., "dashboard.welcome"
  translatedText    String   @db.Text
  
  // Context
  localizationId    String
  localization      Localization @relation(fields: [localizationId], references: [id], onDelete: Cascade)
  
  // Module/context
  module            String?  @db.VarChar(100) // e.g., "crm", "inventory"
  context           String?  @db.Text // Additional context for translators
  
  // Status
  isApproved        Boolean  @default(false)
  translatedBy      String?  @db.VarChar(255)
  approvedBy        String?  @db.VarChar(255)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([translationKey, localizationId])
  @@index([localizationId, module])
  @@index([translationKey])
}

// Transfer Pricing model for intercompany transactions
model TransferPricing {
  id                String   @id @default(uuid())
  
  // Transaction details
  transactionNumber String   @unique @db.VarChar(100)
  transactionDate   DateTime
  
  // Entities involved
  fromEntityId      String   @db.VarChar(100) // Company/subsidiary ID
  fromEntityName    String   @db.VarChar(255)
  fromCountry       String   @db.VarChar(2)
  
  toEntityId        String   @db.VarChar(100)
  toEntityName      String   @db.VarChar(255)
  toCountry         String   @db.VarChar(2)
  
  // Transaction type
  transactionType   String   @db.VarChar(100) // goods, services, intangibles, financing
  description       String   @db.Text
  
  // Pricing
  armLengthPrice    Float    // Market price between unrelated parties
  actualPrice       Float    // Actual intercompany price
  currency          String   @db.VarChar(3)
  variance          Float?   // actualPrice - armLengthPrice
  variancePercent   Float?   // (variance / armLengthPrice) * 100
  
  // Pricing method
  pricingMethod     String   @db.VarChar(100) // CUP, Resale Price, Cost Plus, TNMM, Profit Split
  methodJustification String? @db.Text
  
  // Comparables
  comparableData    String?  @db.Text // JSON array of comparable transactions
  
  // Documentation
  documentationIds  String[] // Array of document IDs
  documentationStatus String @default("pending") // pending, complete, approved
  
  // Compliance
  complianceStatus  String   @default("compliant") // compliant, under_review, non_compliant
  reviewedBy        String?  @db.VarChar(255)
  reviewDate        DateTime?
  
  // Audit trail
  createdBy         String   @db.VarChar(255)
  approvedBy        String?  @db.VarChar(255)
  approvalDate      DateTime?
  
  // Relations
  reportItems       TransferPricingReportItem[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([fromEntityId, toEntityId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([complianceStatus])
}

// Transfer Pricing Report model
model TransferPricingReport {
  id                String   @id @default(uuid())
  
  // Report details
  reportNumber      String   @unique @db.VarChar(100)
  reportType        String   @db.VarChar(100) // annual, quarterly, ad_hoc
  fiscalYear        Int
  fiscalPeriod      String?  @db.VarChar(20) // e.g., "Q1", "Q2"
  
  // Scope
  entityId          String   @db.VarChar(100)
  entityName        String   @db.VarChar(255)
  country           String   @db.VarChar(2)
  
  // Transactions included (via join table)
  reportItems       TransferPricingReportItem[]
  
  // Summary
  totalTransactions Int      @default(0)
  totalValue        Float    @default(0)
  currency          String   @db.VarChar(3)
  
  // Compliance
  complianceStatus  String   @default("draft") // draft, submitted, approved, rejected
  submittedTo       String?  @db.VarChar(255) // Tax authority
  submissionDate    DateTime?
  
  // Documentation
  reportFileUrl     String?  @db.Text
  supportingDocs    String[] // Array of document URLs
  
  // Audit trail
  preparedBy        String   @db.VarChar(255)
  reviewedBy        String?  @db.VarChar(255)
  approvedBy        String?  @db.VarChar(255)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([entityId, fiscalYear])
  @@index([reportType, complianceStatus])
  @@index([submissionDate])
}

// Join table for TransferPricing and TransferPricingReport many-to-many relationship
model TransferPricingReportItem {
  id                String   @id @default(uuid())
  
  transferPricingId String
  transferPricing   TransferPricing @relation(fields: [transferPricingId], references: [id], onDelete: Cascade)
  
  reportId          String
  report            TransferPricingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  // Item-specific notes
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  
  @@unique([transferPricingId, reportId])
  @@index([transferPricingId])
  @@index([reportId])
}

// Global Supply Network Node model
model SupplyNetworkNode {
  id                String   @id @default(uuid())
  
  // Node details
  nodeCode          String   @unique @db.VarChar(50)
  nodeName          String   @db.VarChar(255)
  nodeType          String   @db.VarChar(50) // supplier, manufacturer, warehouse, distribution_center, customer
  
  // Location
  country           String   @db.VarChar(2)
  state             String?  @db.VarChar(100)
  city              String   @db.VarChar(255)
  address           String?  @db.Text
  latitude          Float?
  longitude         Float?
  
  // Capacity
  capacity          Float?   // Maximum throughput
  capacityUnit      String?  @db.VarChar(50) // units, tons, pallets
  currentUtilization Float?  @default(0) // Percentage
  
  // Cost
  fixedCost         Float?   @default(0) // Fixed operating cost per period
  variableCost      Float?   @default(0) // Variable cost per unit
  currency          String   @default("USD") @db.VarChar(3)
  
  // Operational details
  operatingHours    String?  @db.VarChar(100) // e.g., "24/7", "Mon-Fri 8-17"
  leadTime          Int?     // Days
  
  // Status
  isActive          Boolean  @default(true)
  status            String   @default("operational") // operational, maintenance, closed
  
  // Relations
  outboundRoutes    SupplyNetworkRoute[] @relation("RouteOrigin")
  inboundRoutes     SupplyNetworkRoute[] @relation("RouteDestination")
  
  // Metadata
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([nodeType, isActive])
  @@index([country, city])
  @@index([status])
}

// Global Supply Network Route model
model SupplyNetworkRoute {
  id                String   @id @default(uuid())
  
  // Route details
  routeCode         String   @unique @db.VarChar(50)
  routeName         String?  @db.VarChar(255)
  
  // Origin and destination
  originNodeId      String
  originNode        SupplyNetworkNode @relation("RouteOrigin", fields: [originNodeId], references: [id], onDelete: Cascade)
  
  destinationNodeId String
  destinationNode   SupplyNetworkNode @relation("RouteDestination", fields: [destinationNodeId], references: [id], onDelete: Cascade)
  
  // Transportation
  transportMode     String   @db.VarChar(50) // truck, rail, air, sea, pipeline
  carrier           String?  @db.VarChar(255)
  
  // Cost
  costPerUnit       Float    // Cost per unit transported
  costPerKm         Float?   // Alternative: cost per kilometer
  currency          String   @default("USD") @db.VarChar(3)
  
  // Time
  leadTime          Int      // Days
  transitTime       Int?     // Hours
  
  // Capacity
  capacity          Float?   // Maximum capacity per shipment
  capacityUnit      String?  @db.VarChar(50)
  
  // Distance
  distance          Float?   // Kilometers
  
  // Constraints
  minShipmentSize   Float?
  maxShipmentSize   Float?
  
  // Service level
  reliabilityScore  Float?   @default(100) // Percentage (0-100)
  onTimeDelivery    Float?   @default(100) // Percentage (0-100)
  
  // Status
  isActive          Boolean  @default(true)
  
  // Metadata
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([originNodeId, destinationNodeId])
  @@index([transportMode, isActive])
  @@index([carrier])
}

// Supply Network Optimization model
model SupplyNetworkOptimization {
  id                String   @id @default(uuid())
  
  // Optimization run details
  optimizationNumber String  @unique @db.VarChar(100)
  optimizationName  String   @db.VarChar(255)
  
  // Scope
  nodeIds           String[] // Array of node IDs included
  routeIds          String[] // Array of route IDs included
  
  // Objective
  objectiveFunction String   @db.VarChar(100) // minimize_cost, minimize_time, maximize_service, balanced
  
  // Constraints
  constraints       String   @db.Text // JSON object with constraints
  
  // Demand scenario
  demandScenario    String   @db.Text // JSON object with demand by product/location
  
  // Results
  status            String   @default("pending") // pending, running, completed, failed
  totalCost         Float?
  totalTime         Float?   // Total lead time
  serviceLevel      Float?   // Percentage
  
  // Optimization details
  algorithm         String?  @db.VarChar(100) // linear_programming, genetic_algorithm, simulated_annealing
  iterations        Int?
  convergenceScore  Float?
  
  // Solution
  solution          String?  @db.Text // JSON object with optimal flows
  
  // Execution
  startedAt         DateTime?
  completedAt       DateTime?
  executionTime     Int?     // Seconds
  
  // Audit trail
  createdBy         String   @db.VarChar(255)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([status])
  @@index([createdBy])
  @@index([completedAt])
}

// ─── Multi-Tenant Platform Module ──────────────────────────

model Tenant {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  domain          String   @unique @db.VarChar(255) // Subdomain or custom domain
  slug            String   @unique @db.VarChar(100) // URL-friendly identifier
  
