// ETL Job Management

model ETLJob {
  id                  String   @id @default(uuid())
  jobName             String   @db.VarChar(255)
  jobType             String   @db.VarChar(50) // full_load, incremental, dimension, fact
  sourceTable         String   @db.VarChar(255)
  targetTable         String   @db.VarChar(255)
  status              String   @db.VarChar(50) // pending, running, completed, failed
  startTime           DateTime
  endTime             DateTime?
  recordsProcessed    Int      @default(0)
  recordsInserted     Int      @default(0)
  recordsUpdated      Int      @default(0)
  recordsFailed       Int      @default(0)
  errorMessage        String?  @db.Text
  lastSuccessfulRun   DateTime?
  nextScheduledRun    DateTime?
  schedule            String?  @db.VarChar(100) // cron expression
  
  logs                ETLJobLog[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([jobName, status])
  @@index([status])
  @@index([nextScheduledRun])
}

model ETLJobLog {
  id                  String   @id @default(uuid())
  jobId               String
  logLevel            String   @db.VarChar(20) // info, warning, error
  message             String   @db.Text
  details             Json?
  timestamp           DateTime @default(now())
  
  job                 ETLJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@index([jobId, timestamp])
  @@index([logLevel])
}

// Data Quality Metrics

model DataQualityMetric {
  id                  String   @id @default(uuid())
  tableName           String   @db.VarChar(255)
  metricType          String   @db.VarChar(50) // completeness, accuracy, consistency, timeliness
  metricName          String   @db.VarChar(255)
  metricValue         Float
  threshold           Float
  status              String   @db.VarChar(20) // pass, warning, fail
  checkDate           DateTime @db.Date
  details             Json?
  
  createdAt           DateTime @default(now())
  
  @@index([tableName, checkDate])
  @@index([metricType, status])
  @@index([status])
}

// KPI Definitions and Tracking

model KPIDefinition {
  id                  String   @id @default(uuid())
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  category            String   @db.VarChar(100) // sales, inventory, finance, hr, operations
  calculationFormula  String   @db.Text
  unit                String   @db.VarChar(50) // percentage, currency, count, ratio
  targetValue         Float?
  thresholdGood       Float?
  thresholdWarning    Float?
  frequency           String   @db.VarChar(50) // daily, weekly, monthly, quarterly, yearly
  isActive            Boolean  @default(true)
  
  values              KPIValue[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([category, isActive])
  @@index([isActive])
}

model KPIValue {
  id                  String   @id @default(uuid())
  kpiId               String
  periodStart         DateTime @db.Date
  periodEnd           DateTime @db.Date
  actualValue         Float
  targetValue         Float?
  variance            Float?
  variancePercent     Float?
  trend               String?  @db.VarChar(20) // up, down, stable
  status              String   @db.VarChar(20) // good, warning, critical
  
  kpi                 KPIDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())
  
  @@unique([kpiId, periodStart, periodEnd])
  @@index([kpiId, periodStart])
  @@index([status])
}

// Report Scheduling

model ScheduledReport {
  id                  String   @id @default(uuid())
  reportTemplateId    String
  name                String   @db.VarChar(255)
  schedule            String   @db.VarChar(100) // cron expression
  recipients          String[] // Array of email addresses
  format              String   @db.VarChar(20) // pdf, excel, csv
  parameters          Json?    // Report parameters
  isActive            Boolean  @default(true)
  lastRun             DateTime?
  nextRun             DateTime?
  
  executions          ReportExecution[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([isActive, nextRun])
  @@index([reportTemplateId])
}

model ReportExecution {
  id                  String   @id @default(uuid())
  scheduledReportId   String?
  reportTemplateId    String
  executedBy          String?  @db.VarChar(100)
  status              String   @db.VarChar(50) // pending, running, completed, failed
  startTime           DateTime
  endTime             DateTime?
  fileUrl             String?  @db.VarChar(1024)
  fileSize            Int?
  recordCount         Int?
  errorMessage        String?  @db.Text
  
  scheduledReport     ScheduledReport? @relation(fields: [scheduledReportId], references: [id], onDelete: SetNull)
  
  @@index([scheduledReportId])
  @@index([reportTemplateId, startTime])
  @@index([status])
}


// ─── Industry 4.0 Module ───────────────────────────────────

// Shop Floor Operation Tracking
model ShopFloorOperation {
