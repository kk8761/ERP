  isolationStrategy String @default("shared") @db.VarChar(50) // shared, schema, database
  databaseSchema  String?  @db.VarChar(100) // For schema-based isolation
  databaseName    String?  @db.VarChar(100) // For database-based isolation
  
  // Contact information
  contactName     String?  @db.VarChar(255)
  contactEmail    String   @db.VarChar(255)
  contactPhone    String?  @db.VarChar(50)
  
  // Billing
