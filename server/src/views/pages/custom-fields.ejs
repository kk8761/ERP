<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Custom Fields - NexaERP</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 2rem;
    }

    .header h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .header p {
      opacity: 0.9;
    }

    .content {
      padding: 2rem;
    }

    .entity-selector {
      margin-bottom: 2rem;
    }

    .entity-selector label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #333;
    }

    .entity-selector select {
      width: 100%;
      padding: 0.75rem;
      border: 2px solid #e2e8f0;
      border-radius: 8px;
      font-size: 1rem;
      background: white;
      cursor: pointer;
      transition: border-color 0.3s;
    }

    .entity-selector select:focus {
      outline: none;
      border-color: #667eea;
    }

    .actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(102, 126, 234, 0.4);
    }

    .fields-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
    }

    .fields-table th,
    .fields-table td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
    }

    .fields-table th {
      background: #f7fafc;
      font-weight: 600;
      color: #4a5568;
    }

    .fields-table tr:hover {
      background: #f7fafc;
    }

    .badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 12px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .badge-text {
      background: #e6fffa;
      color: #047857;
    }

    .badge-number {
      background: #dbeafe;
      color: #1e40af;
    }

    .badge-boolean {
      background: #fef3c7;
      color: #92400e;
    }

    .badge-date {
      background: #fce7f3;
      color: #9f1239;
    }

    .badge-select {
      background: #ede9fe;
      color: #5b21b6;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: #718096;
    }

    .empty-state svg {
      width: 100px;
      height: 100px;
      margin-bottom: 1rem;
      opacity: 0.5;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      background: white;
      border-radius: 12px;
      padding: 2rem;
      max-width: 600px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .modal-header h2 {
      font-size: 1.5rem;
      color: #333;
    }

    .close-btn {
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: #718096;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #333;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem;
      border: 2px solid #e2e8f0;
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.3s;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #667eea;
    }

    .form-group small {
      display: block;
      margin-top: 0.25rem;
      color: #718096;
      font-size: 0.875rem;
    }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .checkbox-group input[type="checkbox"] {
      width: auto;
    }

    .btn-group {
      display: flex;
      gap: 1rem;
      justify-content: flex-end;
      margin-top: 2rem;
    }

    .btn-secondary {
      background: #e2e8f0;
      color: #4a5568;
    }

    .btn-secondary:hover {
      background: #cbd5e0;
    }

    .action-buttons {
      display: flex;
      gap: 0.5rem;
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }

    .btn-danger {
      background: #ef4444;
      color: white;
    }

    .btn-danger:hover {
      background: #dc2626;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Custom Fields</h1>
      <p>Extend standard entities with custom fields</p>
    </div>

    <div class="content">
      <div class="entity-selector">
        <label for="entitySelect">Select Entity</label>
        <select id="entitySelect">
          <option value="">-- Select an entity --</option>
          <option value="Product">Product</option>
          <option value="Customer">Customer</option>
          <option value="Order">Order</option>
          <option value="Lead">Lead</option>
          <option value="Opportunity">Opportunity</option>
          <option value="Invoice">Invoice</option>
          <option value="PurchaseOrder">Purchase Order</option>
          <option value="Supplier">Supplier</option>
          <option value="Employee">Employee</option>
          <option value="Asset">Asset</option>
          <option value="Project">Project</option>
        </select>
      </div>

      <div class="actions">
        <h2 id="entityTitle">Select an entity to view custom fields</h2>
        <button class="btn btn-primary" id="addFieldBtn" style="display: none;">
          + Add Custom Field
        </button>
      </div>

      <div id="fieldsContainer">
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p>Select an entity to view and manage custom fields</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Add/Edit Field Modal -->
  <div class="modal" id="fieldModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modalTitle">Add Custom Field</h2>
        <button class="close-btn" id="closeModal">&times;</button>
      </div>

      <form id="fieldForm">
        <div class="form-group">
          <label for="fieldName">Field Name *</label>
          <input type="text" id="fieldName" required placeholder="e.g., warranty_period">
          <small>Use lowercase letters, numbers, and underscores only</small>
        </div>

        <div class="form-group">
          <label for="fieldLabel">Field Label *</label>
          <input type="text" id="fieldLabel" required placeholder="e.g., Warranty Period">
        </div>

        <div class="form-group">
          <label for="fieldType">Field Type *</label>
          <select id="fieldType" required>
            <option value="text">Text</option>
            <option value="number">Number</option>
            <option value="boolean">Boolean (Yes/No)</option>
            <option value="date">Date</option>
            <option value="datetime">Date & Time</option>
            <option value="select">Select (Dropdown)</option>
            <option value="multiselect">Multi-Select</option>
            <option value="textarea">Text Area</option>
          </select>
        </div>

        <div class="form-group" id="optionsGroup" style="display: none;">
          <label for="fieldOptions">Options (one per line) *</label>
          <textarea id="fieldOptions" rows="4" placeholder="Option 1&#10;Option 2&#10;Option 3"></textarea>
        </div>

        <div class="form-group">
          <label for="helpText">Help Text</label>
          <input type="text" id="helpText" placeholder="Additional information for users">
        </div>

        <div class="form-group">
          <label for="defaultValue">Default Value</label>
          <input type="text" id="defaultValue" placeholder="Optional default value">
        </div>

        <div class="form-group checkbox-group">
          <input type="checkbox" id="isRequired">
          <label for="isRequired">Required Field</label>
        </div>

        <div class="btn-group">
          <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Field</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const entitySelect = document.getElementById('entitySelect');
    const addFieldBtn = document.getElementById('addFieldBtn');
    const fieldsContainer = document.getElementById('fieldsContainer');
    const entityTitle = document.getElementById('entityTitle');
    const fieldModal = document.getElementById('fieldModal');
    const fieldForm = document.getElementById('fieldForm');
    const fieldType = document.getElementById('fieldType');
    const optionsGroup = document.getElementById('optionsGroup');
    const closeModal = document.getElementById('closeModal');
    const cancelBtn = document.getElementById('cancelBtn');

    let currentEntity = '';
    let editingFieldId = null;

    // Entity selection
    entitySelect.addEventListener('change', async (e) => {
      currentEntity = e.target.value;
      if (currentEntity) {
        entityTitle.textContent = `${currentEntity} Custom Fields`;
        addFieldBtn.style.display = 'block';
        await loadFields();
      } else {
        entityTitle.textContent = 'Select an entity to view custom fields';
        addFieldBtn.style.display = 'none';
        showEmptyState();
      }
    });

    // Field type change
    fieldType.addEventListener('change', (e) => {
      if (e.target.value === 'select' || e.target.value === 'multiselect') {
        optionsGroup.style.display = 'block';
      } else {
        optionsGroup.style.display = 'none';
      }
    });

    // Load fields for entity
    async function loadFields() {
      try {
        const response = await fetch(`/api/custom-fields/${currentEntity}`);
        const data = await response.json();

        if (data.success && data.fields.length > 0) {
          renderFields(data.fields);
        } else {
          showEmptyState('No custom fields defined for this entity yet.');
        }
      } catch (error) {
        console.error('Error loading fields:', error);
        showEmptyState('Error loading custom fields.');
      }
    }

    // Render fields table
    function renderFields(fields) {
      const html = `
        <table class="fields-table">
          <thead>
            <tr>
              <th>Field Name</th>
              <th>Label</th>
              <th>Type</th>
              <th>Required</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${fields.map(field => `
              <tr>
                <td><code>${field.fieldName}</code></td>
                <td>${field.fieldLabel}</td>
                <td><span class="badge badge-${field.fieldType}">${field.fieldType}</span></td>
                <td>${field.isRequired ? 'Yes' : 'No'}</td>
                <td>
                  <div class="action-buttons">
                    <button class="btn btn-sm btn-secondary" onclick="editField('${field.id}')">Edit</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteField('${field.id}')">Delete</button>
                  </div>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
      fieldsContainer.innerHTML = html;
    }

    // Show empty state
    function showEmptyState(message = 'Select an entity to view and manage custom fields') {
      fieldsContainer.innerHTML = `
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p>${message}</p>
        </div>
      `;
    }

    // Open modal
    addFieldBtn.addEventListener('click', () => {
      editingFieldId = null;
      fieldForm.reset();
      document.getElementById('modalTitle').textContent = 'Add Custom Field';
      fieldModal.classList.add('active');
    });

    // Close modal
    closeModal.addEventListener('click', () => {
      fieldModal.classList.remove('active');
    });

    cancelBtn.addEventListener('click', () => {
      fieldModal.classList.remove('active');
    });

    // Submit form
    fieldForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fieldData = {
        entityName: currentEntity,
        fieldName: document.getElementById('fieldName').value,
        fieldLabel: document.getElementById('fieldLabel').value,
        fieldType: document.getElementById('fieldType').value,
        dataType: getDataType(document.getElementById('fieldType').value),
        helpText: document.getElementById('helpText').value,
        defaultValue: document.getElementById('defaultValue').value,
        isRequired: document.getElementById('isRequired').checked,
      };

      // Add options for select fields
      if (fieldData.fieldType === 'select' || fieldData.fieldType === 'multiselect') {
        const optionsText = document.getElementById('fieldOptions').value;
        fieldData.options = optionsText.split('\n')
          .filter(line => line.trim())
          .map(line => ({ label: line.trim(), value: line.trim().toLowerCase().replace(/\s+/g, '_') }));
      }

      try {
        const url = editingFieldId ? `/api/custom-fields/${editingFieldId}` : '/api/custom-fields';
        const method = editingFieldId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(fieldData),
        });

        const data = await response.json();

        if (data.success) {
          fieldModal.classList.remove('active');
          await loadFields();
          alert('Custom field saved successfully!');
        } else {
          alert('Error: ' + data.message);
        }
      } catch (error) {
        console.error('Error saving field:', error);
        alert('Error saving custom field');
      }
    });

    // Get data type from field type
    function getDataType(fieldType) {
      const mapping = {
        text: 'varchar',
        number: 'decimal',
        boolean: 'boolean',
        date: 'date',
        datetime: 'timestamp',
        select: 'varchar',
        multiselect: 'json',
        textarea: 'text',
      };
      return mapping[fieldType] || 'varchar';
    }

    // Edit field
    window.editField = async (fieldId) => {
      // Implementation for editing would go here
      alert('Edit functionality coming soon!');
    };

    // Delete field
    window.deleteField = async (fieldId) => {
      if (!confirm('Are you sure you want to delete this custom field?')) {
        return;
      }

      try {
        const response = await fetch(`/api/custom-fields/${fieldId}`, {
          method: 'DELETE',
        });

        const data = await response.json();

        if (data.success) {
          await loadFields();
          alert('Custom field deleted successfully!');
        } else {
          alert('Error: ' + data.message);
        }
      } catch (error) {
        console.error('Error deleting field:', error);
        alert('Error deleting custom field');
      }
    };
  </script>
</body>
</html>
