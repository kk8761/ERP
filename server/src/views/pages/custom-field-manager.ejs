<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Custom Field Manager - NexaERP</title>
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    .custom-field-manager {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    .entity-selector {
      margin-bottom: 2rem;
      padding: 1.5rem;
      background: var(--surface-color);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
    }

    .entity-selector select {
      width: 100%;
      max-width: 400px;
      padding: 0.75rem;
      font-size: 1rem;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background: var(--background-color);
      color: var(--text-primary);
    }

    .fields-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .field-card {
      padding: 1.5rem;
      background: var(--surface-color);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-color);
      transition: all 0.2s;
    }

    .field-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .field-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 1rem;
    }

    .field-name {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 0.25rem;
    }

    .field-type-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      background: var(--primary-color);
      color: white;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
    }

    .field-details {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: 0.5rem;
    }

    .field-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .btn {
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-primary {
      background: var(--primary-color);
      color: white;
    }

    .btn-secondary {
      background: var(--surface-color);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
    }

    .btn-danger {
      background: var(--error-color);
      color: white;
    }

    .btn:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    .add-field-btn {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--primary-color);
      color: white;
      font-size: 2rem;
      border: none;
      cursor: pointer;
      box-shadow: var(--shadow-lg);
      transition: all 0.2s;
      z-index: 100;
    }

    .add-field-btn:hover {
      transform: scale(1.1);
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      background: var(--surface-color);
      padding: 2rem;
      border-radius: 16px;
      max-width: 600px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-xl);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .modal-title {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .close-btn {
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: var(--text-secondary);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      color: var(--text-primary);
    }

    .form-input,
    .form-select,
    .form-textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background: var(--background-color);
      color: var(--text-primary);
      font-size: 1rem;
    }

    .form-textarea {
      min-height: 100px;
      resize: vertical;
    }

    .form-checkbox {
      margin-right: 0.5rem;
    }

    .checkbox-group {
      display: flex;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-secondary);
    }

    .empty-state-icon {
      font-size: 4rem;
      margin-bottom: 1rem;
    }

    .required-indicator {
      color: var(--error-color);
      margin-left: 0.25rem;
    }

    .options-list {
      margin-top: 0.5rem;
    }

    .option-item {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .option-item input {
      flex: 1;
    }

    .remove-option-btn {
      padding: 0.5rem;
      background: var(--error-color);
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }

    .add-option-btn {
      margin-top: 0.5rem;
      padding: 0.5rem 1rem;
      background: var(--primary-color);
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <div class="custom-field-manager">
    <h1>Custom Field Manager</h1>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
      Add custom fields to standard entities to capture additional information specific to your business needs.
    </p>

    <div class="entity-selector">
      <label for="entitySelect" class="form-label">Select Entity</label>
      <select id="entitySelect" class="form-select">
        <option value="">-- Select an entity --</option>
        <option value="Product">Product</option>
        <option value="Customer">Customer</option>
        <option value="Order">Order</option>
        <option value="Lead">Lead</option>
        <option value="Opportunity">Opportunity</option>
        <option value="Invoice">Invoice</option>
        <option value="PurchaseOrder">Purchase Order</option>
        <option value="Supplier">Supplier</option>
        <option value="Employee">Employee</option>
        <option value="Asset">Asset</option>
        <option value="Project">Project</option>
        <option value="Task">Task</option>
        <option value="Ticket">Ticket</option>
        <option value="Contract">Contract</option>
        <option value="Account">Account</option>
      </select>
    </div>

    <div id="fieldsContainer">
      <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <h3>Select an entity to view custom fields</h3>
        <p>Choose an entity from the dropdown above to manage its custom fields.</p>
      </div>
    </div>
  </div>

  <button class="add-field-btn" id="addFieldBtn" title="Add Custom Field" style="display: none;">+</button>

  <!-- Add/Edit Field Modal -->
  <div class="modal" id="fieldModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title" id="modalTitle">Add Custom Field</h2>
        <button class="close-btn" id="closeModal">&times;</button>
      </div>

      <form id="fieldForm">
        <input type="hidden" id="fieldId">

        <div class="form-group">
          <label for="fieldName" class="form-label">
            Field Name <span class="required-indicator">*</span>
          </label>
          <input
            type="text"
            id="fieldName"
            class="form-input"
            placeholder="e.g., warranty_period"
            required
            pattern="[a-zA-Z_][a-zA-Z0-9_]*"
            title="Must start with a letter or underscore, and contain only letters, numbers, and underscores"
          >
          <small style="color: var(--text-secondary);">Use lowercase with underscores (e.g., warranty_period)</small>
        </div>

        <div class="form-group">
          <label for="fieldLabel" class="form-label">
            Field Label <span class="required-indicator">*</span>
          </label>
          <input
            type="text"
            id="fieldLabel"
            class="form-input"
            placeholder="e.g., Warranty Period"
            required
          >
        </div>

        <div class="form-group">
          <label for="fieldType" class="form-label">
            Field Type <span class="required-indicator">*</span>
          </label>
          <select id="fieldType" class="form-select" required>
            <option value="">-- Select type --</option>
            <option value="text">Text</option>
            <option value="number">Number</option>
            <option value="boolean">Boolean (Yes/No)</option>
            <option value="date">Date</option>
            <option value="datetime">Date & Time</option>
            <option value="select">Dropdown (Single Select)</option>
            <option value="multiselect">Multi-Select</option>
            <option value="textarea">Text Area</option>
          </select>
        </div>

        <div class="form-group" id="optionsGroup" style="display: none;">
          <label class="form-label">Options <span class="required-indicator">*</span></label>
          <div id="optionsList" class="options-list"></div>
          <button type="button" class="add-option-btn" id="addOptionBtn">+ Add Option</button>
        </div>

        <div class="form-group">
          <label for="helpText" class="form-label">Help Text</label>
          <textarea
            id="helpText"
            class="form-textarea"
            placeholder="Provide guidance for users filling this field"
          ></textarea>
        </div>

        <div class="form-group">
          <label for="placeholder" class="form-label">Placeholder</label>
          <input
            type="text"
            id="placeholder"
            class="form-input"
            placeholder="e.g., Enter warranty period in months"
          >
        </div>

        <div class="form-group">
          <label for="defaultValue" class="form-label">Default Value</label>
          <input
            type="text"
            id="defaultValue"
            class="form-input"
            placeholder="Optional default value"
          >
        </div>

        <div class="form-group">
          <div class="checkbox-group">
            <input type="checkbox" id="isRequired" class="form-checkbox">
            <label for="isRequired">Required Field</label>
          </div>

          <div class="checkbox-group">
            <input type="checkbox" id="isUnique" class="form-checkbox">
            <label for="isUnique">Unique Values Only</label>
          </div>

          <div class="checkbox-group">
            <input type="checkbox" id="isIndexed" class="form-checkbox">
            <label for="isIndexed">Index for Performance</label>
          </div>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: flex-end;">
          <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Field</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let currentEntity = '';
    let fields = [];
    let editingFieldId = null;

    const entitySelect = document.getElementById('entitySelect');
    const fieldsContainer = document.getElementById('fieldsContainer');
    const addFieldBtn = document.getElementById('addFieldBtn');
    const fieldModal = document.getElementById('fieldModal');
    const fieldForm = document.getElementById('fieldForm');
    const closeModal = document.getElementById('closeModal');
    const cancelBtn = document.getElementById('cancelBtn');
    const fieldType = document.getElementById('fieldType');
    const optionsGroup = document.getElementById('optionsGroup');
    const optionsList = document.getElementById('optionsList');
    const addOptionBtn = document.getElementById('addOptionBtn');

    // Entity selection
    entitySelect.addEventListener('change', async (e) => {
      currentEntity = e.target.value;
      if (currentEntity) {
        addFieldBtn.style.display = 'block';
        await loadFields();
      } else {
        addFieldBtn.style.display = 'none';
        showEmptyState();
      }
    });

    // Load fields for selected entity
    async function loadFields() {
      try {
        const response = await fetch(`/api/custom-fields/${currentEntity}`);
        const data = await response.json();

        if (data.success) {
          fields = data.fields;
          renderFields();
        }
      } catch (error) {
        console.error('Error loading fields:', error);
        alert('Failed to load custom fields');
      }
    }

    // Render fields
    function renderFields() {
      if (fields.length === 0) {
        fieldsContainer.innerHTML = `
          <div class="empty-state">
            <div class="empty-state-icon">📝</div>
            <h3>No custom fields yet</h3>
            <p>Click the + button to add your first custom field to ${currentEntity}.</p>
          </div>
        `;
        return;
      }

      fieldsContainer.innerHTML = `
        <div class="fields-grid">
          ${fields.map(field => `
            <div class="field-card">
              <div class="field-header">
                <div>
                  <div class="field-name">${field.fieldLabel}</div>
                  <div style="font-size: 0.85rem; color: var(--text-secondary);">${field.fieldName}</div>
                </div>
                <span class="field-type-badge">${field.fieldType}</span>
              </div>
              
              ${field.helpText ? `<div class="field-details">${field.helpText}</div>` : ''}
              
              <div class="field-details">
                ${field.isRequired ? '<span style="color: var(--error-color);">● Required</span>' : ''}
                ${field.isUnique ? '<span style="color: var(--warning-color);">● Unique</span>' : ''}
                ${field.isIndexed ? '<span style="color: var(--success-color);">● Indexed</span>' : ''}
              </div>

              <div class="field-actions">
                <button class="btn btn-secondary" onclick="editField('${field.id}')">Edit</button>
                <button class="btn btn-danger" onclick="deleteField('${field.id}')">Delete</button>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    // Show empty state
    function showEmptyState() {
      fieldsContainer.innerHTML = `
        <div class="empty-state">
          <div class="empty-state-icon">📋</div>
          <h3>Select an entity to view custom fields</h3>
          <p>Choose an entity from the dropdown above to manage its custom fields.</p>
        </div>
      `;
    }

    // Open modal for adding field
    addFieldBtn.addEventListener('click', () => {
      editingFieldId = null;
      fieldForm.reset();
      document.getElementById('modalTitle').textContent = 'Add Custom Field';
      fieldModal.classList.add('active');
    });

    // Close modal
    closeModal.addEventListener('click', () => {
      fieldModal.classList.remove('active');
    });

    cancelBtn.addEventListener('click', () => {
      fieldModal.classList.remove('active');
    });

    // Field type change
    fieldType.addEventListener('change', (e) => {
      if (e.target.value === 'select' || e.target.value === 'multiselect') {
        optionsGroup.style.display = 'block';
        if (optionsList.children.length === 0) {
          addOption();
        }
      } else {
        optionsGroup.style.display = 'none';
      }
    });

    // Add option
    addOptionBtn.addEventListener('click', addOption);

    function addOption(label = '', value = '') {
      const optionItem = document.createElement('div');
      optionItem.className = 'option-item';
      optionItem.innerHTML = `
        <input type="text" placeholder="Label" value="${label}" class="form-input option-label">
        <input type="text" placeholder="Value" value="${value}" class="form-input option-value">
        <button type="button" class="remove-option-btn" onclick="this.parentElement.remove()">×</button>
      `;
      optionsList.appendChild(optionItem);
    }

    // Edit field
    window.editField = function(fieldId) {
      const field = fields.find(f => f.id === fieldId);
      if (!field) return;

      editingFieldId = fieldId;
      document.getElementById('modalTitle').textContent = 'Edit Custom Field';
      document.getElementById('fieldId').value = field.id;
      document.getElementById('fieldName').value = field.fieldName;
      document.getElementById('fieldName').disabled = true; // Can't change field name
      document.getElementById('fieldLabel').value = field.fieldLabel;
      document.getElementById('fieldType').value = field.fieldType;
      document.getElementById('fieldType').disabled = true; // Can't change field type
      document.getElementById('helpText').value = field.helpText || '';
      document.getElementById('placeholder').value = field.placeholder || '';
      document.getElementById('defaultValue').value = field.defaultValue || '';
      document.getElementById('isRequired').checked = field.isRequired;
      document.getElementById('isUnique').checked = field.isUnique;
      document.getElementById('isIndexed').checked = field.isIndexed;

      // Load options if select field
      if (field.fieldType === 'select' || field.fieldType === 'multiselect') {
        optionsGroup.style.display = 'block';
        optionsList.innerHTML = '';
        if (field.options && field.options.length > 0) {
          field.options.forEach(opt => addOption(opt.label, opt.value));
        }
      }

      fieldModal.classList.add('active');
    };

    // Delete field
    window.deleteField = async function(fieldId) {
      if (!confirm('Are you sure you want to delete this custom field? This action cannot be undone.')) {
        return;
      }

      try {
        const response = await fetch(`/api/custom-fields/${fieldId}`, {
          method: 'DELETE',
        });

        const data = await response.json();

        if (data.success) {
          alert('Custom field deleted successfully');
          await loadFields();
        } else {
          alert('Failed to delete custom field: ' + data.message);
        }
      } catch (error) {
        console.error('Error deleting field:', error);
        alert('Failed to delete custom field');
      }
    };

    // Submit form
    fieldForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fieldData = {
        entityName: currentEntity,
        fieldName: document.getElementById('fieldName').value,
        fieldLabel: document.getElementById('fieldLabel').value,
        fieldType: document.getElementById('fieldType').value,
        dataType: getDataType(document.getElementById('fieldType').value),
        helpText: document.getElementById('helpText').value,
        placeholder: document.getElementById('placeholder').value,
        defaultValue: document.getElementById('defaultValue').value,
        isRequired: document.getElementById('isRequired').checked,
        isUnique: document.getElementById('isUnique').checked,
        isIndexed: document.getElementById('isIndexed').checked,
      };

      // Get options for select fields
      if (fieldData.fieldType === 'select' || fieldData.fieldType === 'multiselect') {
        const options = [];
        const optionItems = optionsList.querySelectorAll('.option-item');
        optionItems.forEach(item => {
          const label = item.querySelector('.option-label').value;
          const value = item.querySelector('.option-value').value;
          if (label && value) {
            options.push({ label, value });
          }
        });
        fieldData.options = options;

        if (options.length === 0) {
          alert('Please add at least one option for select fields');
          return;
        }
      }

      try {
        let response;
        if (editingFieldId) {
          response = await fetch(`/api/custom-fields/${editingFieldId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(fieldData),
          });
        } else {
          response = await fetch('/api/custom-fields', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(fieldData),
          });
        }

        const data = await response.json();

        if (data.success) {
          alert(editingFieldId ? 'Custom field updated successfully' : 'Custom field created successfully');
          fieldModal.classList.remove('active');
          await loadFields();
        } else {
          alert('Failed to save custom field: ' + data.message);
        }
      } catch (error) {
        console.error('Error saving field:', error);
        alert('Failed to save custom field');
      }
    });

    // Get data type from field type
    function getDataType(fieldType) {
      const mapping = {
        text: 'varchar',
        number: 'decimal',
        boolean: 'boolean',
        date: 'date',
        datetime: 'timestamp',
        select: 'varchar',
        multiselect: 'json',
        textarea: 'text',
      };
      return mapping[fieldType] || 'varchar';
    }
  </script>
</body>
</html>
