<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Custom Entity Designer - NexaERP</title>
  <link rel="stylesheet" href="/css/design-system.css">
  <style>
    .designer-container {
      display: grid;
      grid-template-columns: 300px 1fr 350px;
      gap: 20px;
      height: calc(100vh - 120px);
      padding: 20px;
    }

    .designer-panel {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
    }

    .panel-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 20px;
      color: #1a1a1a;
    }

    .field-type-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .field-type-item {
      padding: 12px;
      background: #f5f5f5;
      border-radius: 6px;
      cursor: grab;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .field-type-item:hover {
      background: #e8e8e8;
      transform: translateX(5px);
    }

    .field-type-item.dragging {
      opacity: 0.5;
      cursor: grabbing;
    }

    .canvas {
      background: #fafafa;
      border: 2px dashed #ddd;
      border-radius: 8px;
      min-height: 400px;
      padding: 20px;
    }

    .canvas.drag-over {
      background: #e8f4ff;
      border-color: #0066cc;
    }

    .canvas-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: #999;
      text-align: center;
    }

    .canvas-empty-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }

    .field-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .field-item {
      background: white;
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 16px;
      cursor: move;
      transition: all 0.2s;
    }

    .field-item:hover {
      border-color: #0066cc;
      box-shadow: 0 2px 8px rgba(0, 102, 204, 0.1);
    }

    .field-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .field-item-name {
      font-weight: 600;
      color: #1a1a1a;
    }

    .field-item-type {
      font-size: 12px;
      color: #666;
      background: #f0f0f0;
      padding: 4px 8px;
      border-radius: 4px;
    }

    .field-item-actions {
      display: flex;
      gap: 8px;
    }

    .field-item-actions button {
      padding: 4px 8px;
      font-size: 12px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-edit {
      background: #0066cc;
      color: white;
    }

    .btn-delete {
      background: #dc3545;
      color: white;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      color: #333;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 14px;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #0066cc;
      box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
    }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
    }

    .checkbox-group input[type="checkbox"] {
      width: auto;
    }

    .btn {
      padding: 10px 20px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-primary {
      background: #0066cc;
      color: white;
    }

    .btn-primary:hover {
      background: #0052a3;
    }

    .btn-secondary {
      background: #6c757d;
      color: white;
    }

    .btn-secondary:hover {
      background: #5a6268;
    }

    .btn-success {
      background: #28a745;
      color: white;
    }

    .btn-success:hover {
      background: #218838;
    }

    .btn-block {
      width: 100%;
      margin-top: 16px;
    }

    .required {
      color: #dc3545;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      background: white;
      border-radius: 8px;
      padding: 24px;
      max-width: 600px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .modal-title {
      font-size: 20px;
      font-weight: 600;
    }

    .modal-close {
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: #999;
    }

    .modal-close:hover {
      color: #333;
    }

    .alert {
      padding: 12px 16px;
      border-radius: 6px;
      margin-bottom: 16px;
    }

    .alert-success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }

    .alert-error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
  </style>
</head>
<body>
  <div class="designer-container">
    <!-- Left Panel: Field Types -->
    <div class="designer-panel">
      <h2 class="panel-title">📦 Field Types</h2>
      <div class="field-type-list" id="fieldTypeList">
        <div class="field-type-item" draggable="true" data-type="text">
          <span>📝</span>
          <span>Text</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="number">
          <span>🔢</span>
          <span>Number</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="boolean">
          <span>☑️</span>
          <span>Boolean</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="date">
          <span>📅</span>
          <span>Date</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="datetime">
          <span>🕐</span>
          <span>Date Time</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="select">
          <span>📋</span>
          <span>Select</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="multiselect">
          <span>☑️</span>
          <span>Multi Select</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="email">
          <span>📧</span>
          <span>Email</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="phone">
          <span>📞</span>
          <span>Phone</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="url">
          <span>🔗</span>
          <span>URL</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="textarea">
          <span>📄</span>
          <span>Text Area</span>
        </div>
        <div class="field-type-item" draggable="true" data-type="richtext">
          <span>✍️</span>
          <span>Rich Text</span>
        </div>
      </div>
    </div>

    <!-- Center Panel: Canvas -->
    <div class="designer-panel">
      <h2 class="panel-title">🎨 Entity Designer</h2>
      
      <div class="form-group">
        <label>Entity Name <span class="required">*</span></label>
        <input type="text" id="entityName" placeholder="e.g., Customer Feedback">
      </div>

      <div class="form-group">
        <label>Plural Name <span class="required">*</span></label>
        <input type="text" id="entityPluralName" placeholder="e.g., Customer Feedbacks">
      </div>

      <div class="form-group">
        <label>Icon</label>
        <input type="text" id="entityIcon" placeholder="e.g., 💬" maxlength="2">
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea id="entityDescription" rows="2" placeholder="Brief description of this entity"></textarea>
      </div>

      <hr style="margin: 20px 0; border: none; border-top: 1px solid #ddd;">

      <h3 style="margin-bottom: 16px;">Fields</h3>
      
      <div class="canvas" id="canvas">
        <div class="canvas-empty" id="canvasEmpty">
          <div class="canvas-empty-icon">👈</div>
          <div>Drag and drop field types from the left panel to add fields</div>
        </div>
        <div class="field-list" id="fieldList" style="display: none;"></div>
      </div>

      <button class="btn btn-success btn-block" id="saveEntityBtn">
        💾 Create Entity
      </button>
    </div>

    <!-- Right Panel: Properties -->
    <div class="designer-panel">
      <h2 class="panel-title">⚙️ Field Properties</h2>
      <div id="propertiesPanel">
        <p style="color: #999; text-align: center; margin-top: 40px;">
          Select a field to edit its properties
        </p>
      </div>
    </div>
  </div>

  <!-- Field Configuration Modal -->
  <div class="modal" id="fieldModal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Configure Field</h3>
        <button class="modal-close" onclick="closeFieldModal()">&times;</button>
      </div>
      <div id="fieldModalBody"></div>
    </div>
  </div>

  <script>
    let fields = [];
    let selectedFieldIndex = null;
    let draggedType = null;

    // Initialize drag and drop
    document.querySelectorAll('.field-type-item').forEach(item => {
      item.addEventListener('dragstart', (e) => {
        draggedType = e.target.dataset.type;
        e.target.classList.add('dragging');
      });

      item.addEventListener('dragend', (e) => {
        e.target.classList.remove('dragging');
      });
    });

    const canvas = document.getElementById('canvas');
    canvas.addEventListener('dragover', (e) => {
      e.preventDefault();
      canvas.classList.add('drag-over');
    });

    canvas.addEventListener('dragleave', () => {
      canvas.classList.remove('drag-over');
    });

    canvas.addEventListener('drop', (e) => {
      e.preventDefault();
      canvas.classList.remove('drag-over');
      
      if (draggedType) {
        addField(draggedType);
        draggedType = null;
      }
    });

    function addField(type) {
      const field = {
        name: `field_${fields.length + 1}`,
        label: `Field ${fields.length + 1}`,
        fieldType: type,
        dataType: getDataType(type),
        isRequired: false,
        isUnique: false,
        isIndexed: false,
        options: type === 'select' || type === 'multiselect' ? [] : undefined,
      };

      fields.push(field);
      renderFields();
      openFieldModal(fields.length - 1);
    }

    function getDataType(fieldType) {
      const mappings = {
        text: 'varchar',
        number: 'decimal',
        boolean: 'boolean',
        date: 'date',
        datetime: 'timestamp',
        select: 'varchar',
        multiselect: 'json',
        email: 'varchar',
        phone: 'varchar',
        url: 'varchar',
        textarea: 'text',
        richtext: 'text',
      };
      return mappings[fieldType] || 'varchar';
    }

    function renderFields() {
      const fieldList = document.getElementById('fieldList');
      const canvasEmpty = document.getElementById('canvasEmpty');

      if (fields.length === 0) {
        fieldList.style.display = 'none';
        canvasEmpty.style.display = 'flex';
        return;
      }

      canvasEmpty.style.display = 'none';
      fieldList.style.display = 'flex';

      fieldList.innerHTML = fields.map((field, index) => `
        <div class="field-item">
          <div class="field-item-header">
            <div>
              <div class="field-item-name">${field.label}</div>
              <div class="field-item-type">${field.fieldType}</div>
            </div>
            <div class="field-item-actions">
              <button class="btn-edit" onclick="openFieldModal(${index})">Edit</button>
              <button class="btn-delete" onclick="deleteField(${index})">Delete</button>
            </div>
          </div>
          ${field.isRequired ? '<span style="color: #dc3545; font-size: 12px;">Required</span>' : ''}
        </div>
      `).join('');
    }

    function openFieldModal(index) {
      selectedFieldIndex = index;
      const field = fields[index];
      const modal = document.getElementById('fieldModal');
      const modalBody = document.getElementById('fieldModalBody');

      let optionsHTML = '';
      if (field.fieldType === 'select' || field.fieldType === 'multiselect') {
        const options = field.options || [];
        optionsHTML = `
          <div class="form-group">
            <label>Options (one per line)</label>
            <textarea id="fieldOptions" rows="5" placeholder="Option 1\nOption 2\nOption 3">${options.map(o => o.label).join('\n')}</textarea>
          </div>
        `;
      }

      modalBody.innerHTML = `
        <div class="form-group">
          <label>Field Name <span class="required">*</span></label>
          <input type="text" id="fieldName" value="${field.name}" placeholder="e.g., customer_name">
          <small style="color: #666;">Use lowercase with underscores</small>
        </div>

        <div class="form-group">
          <label>Field Label <span class="required">*</span></label>
          <input type="text" id="fieldLabel" value="${field.label}" placeholder="e.g., Customer Name">
        </div>

        <div class="form-group">
          <label>Field Type</label>
          <input type="text" value="${field.fieldType}" disabled>
        </div>

        ${optionsHTML}

        <div class="form-group">
          <label>Placeholder</label>
          <input type="text" id="fieldPlaceholder" value="${field.placeholder || ''}" placeholder="Enter placeholder text">
        </div>

        <div class="form-group">
          <label>Help Text</label>
          <input type="text" id="fieldHelpText" value="${field.helpText || ''}" placeholder="Additional help text">
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="fieldRequired" ${field.isRequired ? 'checked' : ''}>
          <label for="fieldRequired">Required</label>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="fieldUnique" ${field.isUnique ? 'checked' : ''}>
          <label for="fieldUnique">Unique</label>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="fieldIndexed" ${field.isIndexed ? 'checked' : ''}>
          <label for="fieldIndexed">Indexed</label>
        </div>

        <button class="btn btn-primary btn-block" onclick="saveFieldConfig()">Save Field</button>
      `;

      modal.classList.add('active');
    }

    function closeFieldModal() {
      document.getElementById('fieldModal').classList.remove('active');
    }

    function saveFieldConfig() {
      const field = fields[selectedFieldIndex];
      
      field.name = document.getElementById('fieldName').value;
      field.label = document.getElementById('fieldLabel').value;
      field.placeholder = document.getElementById('fieldPlaceholder')?.value;
      field.helpText = document.getElementById('fieldHelpText')?.value;
      field.isRequired = document.getElementById('fieldRequired').checked;
      field.isUnique = document.getElementById('fieldUnique').checked;
      field.isIndexed = document.getElementById('fieldIndexed').checked;

      if (field.fieldType === 'select' || field.fieldType === 'multiselect') {
        const optionsText = document.getElementById('fieldOptions').value;
        field.options = optionsText.split('\n')
          .filter(line => line.trim())
          .map(line => ({
            label: line.trim(),
            value: line.trim().toLowerCase().replace(/\s+/g, '_')
          }));
      }

      renderFields();
      closeFieldModal();
    }

    function deleteField(index) {
      if (confirm('Are you sure you want to delete this field?')) {
        fields.splice(index, 1);
        renderFields();
      }
    }

    document.getElementById('saveEntityBtn').addEventListener('click', async () => {
      const name = document.getElementById('entityName').value.trim();
      const pluralName = document.getElementById('entityPluralName').value.trim();
      const icon = document.getElementById('entityIcon').value.trim();
      const description = document.getElementById('entityDescription').value.trim();

      if (!name) {
        alert('Please enter an entity name');
        return;
      }

      if (!pluralName) {
        alert('Please enter a plural name');
        return;
      }

      if (fields.length === 0) {
        alert('Please add at least one field');
        return;
      }

      const definition = {
        name,
        pluralName,
        icon,
        description,
        fields,
      };

      try {
        const response = await fetch('/custom-entities/api', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(definition),
        });

        const result = await response.json();

        if (result.success) {
          alert('Entity created successfully!');
          window.location.href = '/custom-entities';
        } else {
          alert('Error: ' + result.message);
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    });
  </script>
</body>
</html>
