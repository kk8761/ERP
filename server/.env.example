# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/nexaerp

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nexaerp?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexaerp
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=10000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-super-secret-cookie-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (optional - for caching and sessions)
REDIS_URL=redis://localhost:6379

# Session Management
SESSION_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SESSIONS=5

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# Tax Engine Configuration
TAX_ENGINE_ENABLED=true
TAX_ENGINE_PROVIDER=internal  # avalara, vertex, or internal
TAX_ENGINE_TEST_MODE=true

# Avalara Configuration (if using Avalara)
# TAX_ENGINE_API_KEY=your_avalara_license_key
# TAX_ENGINE_API_URL=https://rest.avatax.com/api/v2
# TAX_ENGINE_ACCOUNT_ID=your_avalara_account_id
# TAX_ENGINE_COMPANY_CODE=DEFAULT

# Vertex Configuration (if using Vertex)
# TAX_ENGINE_API_KEY=your_vertex_api_key
# TAX_ENGINE_API_URL=https://api.vertexsmb.com/vertex-ws/services/CalculateTax70
# TAX_ENGINE_COMPANY_CODE=your_company_code

# Company Address (for tax calculation)
COMPANY_ADDRESS_LINE1=456 Company Ave
COMPANY_CITY=Seattle
COMPANY_STATE=WA
COMPANY_POSTAL_CODE=98101
COMPANY_COUNTRY=US

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Industry Module Settings
ENABLE_MANUFACTURING_MODULE=true
ENABLE_HEALTHCARE_MODULE=true
ENABLE_BANKING_MODULE=true

# Encryption Configuration (Task 38.2: Encryption at Rest)
# Master encryption key for AES-256-GCM encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Store securely in production (AWS KMS, Azure Key Vault, HashiCorp Vault)
MASTER_ENCRYPTION_KEY=

# Key rotation settings
ENCRYPTION_KEY_ROTATION_DAYS=90
ENCRYPTION_KEY_WARNING_DAYS=7
ENCRYPTION_AUTO_ROTATE=true

# Key management provider (LOCAL, AWS_KMS, AZURE_KEY_VAULT)
ENCRYPTION_KEY_PROVIDER=LOCAL

# AWS KMS Configuration (if using AWS_KMS provider)
# AWS_KMS_KEY_ID=
# AWS_KMS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Azure Key Vault Configuration (if using AZURE_KEY_VAULT provider)
# AZURE_KEY_VAULT_URL=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Key Management Configuration (Task 38.4: Key Management)
# Provider: aws-kms, azure-keyvault, or local (development only)
KEY_PROVIDER=local

# AWS KMS Configuration (if KEY_PROVIDER=aws-kms)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Azure Key Vault Configuration (if KEY_PROVIDER=azure-keyvault)
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# Key rotation policy
KEY_ROTATION_ENABLED=true
KEY_ROTATION_INTERVAL_DAYS=90
KEY_ROTATION_AUTO_ROTATE=true
KEY_ROTATION_NOTIFY_BEFORE_DAYS=7

# Automatic key rotation schedule (cron format)
# Default: Daily at 2:00 AM
KEY_ROTATION_CRON_SCHEDULE=0 2 * * *

# Key deletion grace period (days)
KEY_DELETION_GRACE_PERIOD_DAYS=30

# SIEM Integration Configuration (Task 38.5: SIEM Integration)
# Enable SIEM integration for security event forwarding
SIEM_ENABLED=false

# SIEM endpoint URL (e.g., Splunk HEC, ELK, Azure Sentinel)
# Examples:
# - Splunk: https://splunk.example.com:8088/services/collector/event
# - ELK: https://elasticsearch.example.com:9200/_bulk
# - Azure Sentinel: https://sentinel.azure.com/api/logs
SIEM_ENDPOINT=

# SIEM API key or authentication token
SIEM_API_KEY=

# Batch size for event forwarding (default: 100)
SIEM_BATCH_SIZE=100

# Flush interval in milliseconds (default: 5000ms = 5 seconds)
SIEM_FLUSH_INTERVAL=5000

# Retry attempts for failed SIEM forwarding (default: 3)
SIEM_RETRY_ATTEMPTS=3

# Retry delay in milliseconds (default: 1000ms = 1 second)
SIEM_RETRY_DELAY=1000

# Service name for structured logging
SERVICE_NAME=nexaerp-backend

# Hostname for structured logging (auto-detected if not set)
HOSTNAME=
