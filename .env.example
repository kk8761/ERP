# NexaERP Enterprise Environment Configuration Template
# Copy to .env and configure for your environment
# NEVER commit real credentials to version control

ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_PORT=5173

# Security & Session Secrets
SECRET_KEY=nexa_erp_dev_super_secret_key_987654321_token_safe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION_COOKIE_NAME=nexaerp_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (SQLite for dev, PostgreSQL for production)
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./nexaerp.db
# PostgreSQL (production / Render / Supabase / Neon):
# DATABASE_URL=postgresql+asyncpg://nexa_user:your_password@ep-cool-host.region.aws.neon.tech/nexaerp?ssl=require

# Polyglot Document Store (MongoDB)
# MongoDB Atlas (cloud.mongodb.com) or Local Docker:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=nexaerp

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nexaerp-frontend.onrender.com

# AI Provider Gateway (Groq / Gemini / OpenAI / AWS Bedrock)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Amazon Alexa+, Fire TV & AWS Developer Challenge 2026 Integrations
ALEXA_SKILL_ID=amzn1.ask.skill.nexaerp-voice-command
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_S3_BUCKET=nexaerp-enterprise-documents
AWS_SNS_TOPIC_ARN=
AWS_CLOUDWATCH_LOG_GROUP=/aws/nexaerp/audit

# MCP Integration Service Credential
MCP_API_KEY=

# Initial Bootstrap Admin (Used ONLY for one-time initialization)
BOOTSTRAP_ADMIN_EMAIL=admin@nexaerp.internal
BOOTSTRAP_ADMIN_NAME="Karthik Reddy"
BOOTSTRAP_ADMIN_PASSWORD=Admin@NexaERP2026!
BOOTSTRAP_ADMIN_BRANCH="Main Store"
BOOTSTRAP_ADMIN_ORG="Nexa Global Enterprises"

# SMTP Mail Relay Configuration (Optional - for live email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=procurement@nexaerp.internal
SMTP_FROM_NAME="NexaERP Enterprise Mailer"
SMTP_USE_TLS=true
