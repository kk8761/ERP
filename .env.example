# ==========================================
# NexaERP Environment Configuration Example
# Copy to .env and configure for your environment
# NEVER commit real credentials to version control
# ==========================================

# Application Environment (development | testing | production)
ENVIRONMENT=development
APP_NAME=NexaERP
DEBUG=true
PORT=8000
FRONTEND_PORT=5173

# Security & Session Secrets
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION_COOKIE_NAME=nexaerp_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Primary Relational DBMS (PostgreSQL / SQLite)
# For Render / Supabase / Neon Cloud PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://nexa_user:your_password@ep-cool-host.region.aws.neon.tech/nexaerp?ssl=require
# For Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./nexaerp.db

# Polyglot Document Store (MongoDB)
# For Free MongoDB Atlas Cluster (cloud.mongodb.com):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# For Local Docker MongoDB:
# MONGODB_URI=mongodb://localhost:27017
MONGODB_URI=
MONGODB_DB_NAME=nexaerp

# AI Multi-Provider APIs (All optional - falls back to built-in offline copilot)
# 1. Groq Cloud (Free high-speed open models from https://groq.com):
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Google Gemini API (Free tier from https://aistudio.google.com):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenAI API (https://platform.openai.com):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.onrender.com,https://*.vercel.app

# Frontend API URL (Set in frontend hosting if hosted separately from backend)
VITE_API_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Initial Bootstrap Admin (Used ONLY for one-time initialization)
BOOTSTRAP_ADMIN_EMAIL=admin@nexaerp.internal
BOOTSTRAP_ADMIN_NAME="Karthik Reddy"
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-pass-1234
BOOTSTRAP_ADMIN_BRANCH="Main Store"
BOOTSTRAP_ADMIN_ORG="Nexa Global Enterprises"

# SMTP Mail Relay Configuration (Optional - for live email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="NexaERP Enterprise Mailer"
SMTP_USE_TLS=true
