# ==========================================
# NexaERP Environment Configuration Example
# Copy to .env and configure for your environment
# NEVER commit real credentials to version control
# ==========================================

# Application Environment (development | testing | production)
ENVIRONMENT=development
APP_NAME=NexaERP
DEBUG=true
PORT=8000
FRONTEND_PORT=5173

# Security & Session Secrets
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION_COOKIE_NAME=nexaerp_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database Configuration
# Default is persistent local SQLite. For PostgreSQL use:
# DATABASE_URL=postgresql+asyncpg://nexa_user:nexa_password@localhost:5432/nexaerp_db
DATABASE_URL=sqlite+aiosqlite:///./nexaerp.db

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Initial Bootstrap Admin (Used ONLY for one-time initialization)
# Do NOT leave default passwords in production
BOOTSTRAP_ADMIN_EMAIL=admin@nexaerp.internal
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-pass-1234
BOOTSTRAP_ADMIN_BRANCH="Main Store"
BOOTSTRAP_ADMIN_ORG="Nexa Global Enterprises"

# SMTP Mail Relay Configuration (Optional - for live email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="NexaERP Enterprise Mailer"
SMTP_USE_TLS=true

